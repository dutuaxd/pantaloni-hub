---
import Layout from '../layouts/Layout.astro';
const title = 'Contact pantaloni cu snur lung Atelieraxd';
const description = 'Pantaloni cu snur lung, contact pentru pantaloni cu snur lung si comenzi, informatii clare si optiuni utile pentru cumparare. Vezi detalii acum!';
const canonical = 'https://atelieraxd.ro/contact/';
const schema = { '@context':'https://schema.org', '@type':'LocalBusiness', name:title, url:canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
<section class="bg-white border-b border-ink/10">
  <div class="section grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
    <div>
      <p class="eyebrow">pantaloni cu snur lung</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-black leading-tight md:text-6xl">Contact pentru pantaloni cu snur lung si comenzi</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-ink/70">Formular simplu, date placeholder si canale clare pentru intrebari despre produse, retur sau colaborari.</p>
      <div class="mt-7 flex flex-wrap gap-3"><a class="btn-primary" href="/pantaloni-lungi">Pantaloni cu snur lung</a><a class="btn-secondary" href="/blog">Ghiduri si idei</a></div>
    </div>
    <figure class="overflow-hidden rounded-md border border-ink/10 bg-mist">
      <img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung in tinuta casual clara si moderna" title="Pantaloni cu snur lung" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full object-cover" />
      <figcaption class="px-4 py-3 text-sm text-ink/65">Pantaloni cu snur lung prezentati natural pentru inspiratie de stil.</figcaption>
    </figure>
  </div>
</section>
<section class="section grid gap-8 lg:grid-cols-[1.1fr_.9fr]"><form class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><label class="block text-sm font-bold">Nume<input class="mt-2 w-full rounded-md border border-ink/20 p-3" placeholder="Numele tau"></label><label class="mt-4 block text-sm font-bold">Email<input class="mt-2 w-full rounded-md border border-ink/20 p-3" placeholder="email@example.ro"></label><label class="mt-4 block text-sm font-bold">Mesaj<textarea class="mt-2 min-h-36 w-full rounded-md border border-ink/20 p-3" placeholder="Scrie mesajul"></textarea></label><button class="btn-primary mt-5">Trimite mesajul</button></form><aside class="rounded-md bg-white p-6 shadow-sm"><h2 class="text-2xl font-black">Date rapide</h2><p class="mt-4">Email: contact@example.ro</p><p>Telefon: [PLACEHOLDER_TELEFON]</p><p>Instagram: [PLACEHOLDER_INSTAGRAM]</p><p class="mt-4 text-ink/70">Pentru intrebari despre pantaloni cu snur lung, include marimea dorita si modelul vazut.</p></aside></section>
</Layout>
