---
import Layout from '../layouts/Layout.astro';
const title = 'Seturi barbati casual cu pantaloni si tricou';
const description = 'Seturi barbati casual cu pantaloni cu snur, tricouri basic si tinute lejere pentru vara, oras si weekend.';
const canonical = 'https://atelieraxd.ro/seturi/';
const schema = { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
<section class="bg-white border-b border-ink/10">
  <div class="section grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
    <div>
      <p class="eyebrow">seturi barbati casual</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-black leading-tight md:text-6xl">Seturi casual cu pantaloni cu snur lung</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-ink/70">Seturile ajuta clientul sa cumpere rapid o tinuta completa: pantaloni cu snur lung plus tricou sau bluza simpla.</p>
      <div class="mt-7 flex flex-wrap gap-3"><a class="btn-primary" href="/pantaloni-lungi">Pantaloni cu snur lung</a><a class="btn-secondary" href="/blog">Ghiduri si idei</a></div>
    </div>
    <figure class="overflow-hidden rounded-md border border-ink/10 bg-mist">
      <img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung in tinuta casual clara si moderna" title="Pantaloni cu snur lung" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full object-cover" />
      <figcaption class="px-4 py-3 text-sm text-ink/65">Pantaloni cu snur lung prezentati natural pentru inspiratie de stil.</figcaption>
    </figure>
  </div>
</section>
<section class="section"><div class="mb-8 flex items-end justify-between gap-4"><div><p class="eyebrow">colectie</p><h2 class="text-3xl font-black">Alege rapid modelul potrivit</h2></div><a class="btn-secondary" href="/contact">Intreaba despre stoc</a></div><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Set tricou alb pentru tinute casual" title="Pantaloni cu snur lung 1" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Set tricou alb</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">Pret disponibil la confirmarea stocului</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Set negru casual pentru tinute casual" title="Pantaloni cu snur lung 2" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Set negru casual</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">Pret disponibil la confirmarea stocului</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Set unisex relaxat pentru tinute casual" title="Pantaloni cu snur lung 3" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Set unisex relaxat</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">Pret disponibil la confirmarea stocului</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Set vara pentru tinute casual" title="Pantaloni cu snur lung 4" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Set vara</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">Pret disponibil la confirmarea stocului</p></div></article></div></section><section class="bg-ink text-white"><div class="section grid gap-8 md:grid-cols-[.8fr_1.2fr]"><h2 class="text-3xl font-black">Mai putine decizii pentru client</h2><p class="text-lg leading-8 text-white/75">Pagina de seturi reduce frictiunea: clientul vede combinatia intreaga si intelege imediat cum se poarta pantalonii cu snur lung.</p></div></section>
</Layout>

