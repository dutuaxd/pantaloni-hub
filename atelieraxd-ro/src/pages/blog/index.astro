---
import Layout from '../../layouts/Layout.astro';

const posts = (await Astro.glob('../../content/blog/*/index.md'))
  .filter((p) => !p.frontmatter.draft)
  .sort((a, b) => String(a.frontmatter.slug).localeCompare(String(b.frontmatter.slug)));

const title = 'Ghid pantaloni barbati: materiale, croieli, tinute';
const description = 'Blog despre pantaloni barbati, pantaloni cu snur, pantaloni largi, scurti, materiale, croieli si tinute casual.';
const canonical = 'https://atelieraxd.ro/blog/';

const clusters = [
  ['Materiale', '/blog/051-ce-este-bumbacul', 'bumbac, poliester, elastan, in, denim'],
  ['Croieli', '/blog/483-ce-inseamna-regular-fit', 'regular fit, slim fit, oversized, baggy'],
  ['Comparatii', '/blog/451-bumbac-vs-poliester', 'bumbac vs poliester, regular fit vs oversized'],
  ['Pantaloni scurti', '/pantaloni-scurti', 'vara, bumbac, bermude, cargo'],
  ['Pantaloni cu snur', '/pantaloni-lungi', 'siret, talie reglabila, casual, streetwear'],
  ['Culori', '/blog/531-tricou-negru-barbati', 'negru, alb, gri, bej, bleumarin'],
];
---
<Layout title={title} description={description} canonical={canonical}>
  <section class="bg-white border-b border-ink/10">
    <div class="section">
      <p class="eyebrow">blog pantaloni barbati</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-black leading-tight md:text-6xl">Ghiduri despre pantaloni barbati, materiale si croieli</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-ink/70">Hub editorial pentru cautari informationale: pantaloni cu snur, pantaloni largi barbati, pantaloni scurti barbati, bumbac, poliester, regular fit, oversized si tinute casual.</p>
    </div>
  </section>

  <section class="section">
    <div class="mb-8">
      <p class="eyebrow">clustere seo</p>
      <h2 class="text-3xl font-black">Porneste din clusterul potrivit</h2>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {clusters.map(([label, href, text]) => (
        <article class="rounded-md border border-ink/10 bg-white p-6">
          <h2 class="text-xl font-bold"><a href={href}>{label}</a></h2>
          <p class="mt-3 leading-7 text-ink/70">{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">toate articolele</p>
        <h2 class="text-3xl font-black">Articole SEO pentru pantaloni barbati</h2>
      </div>
      <a class="btn-secondary" href="/pantaloni-lungi">Pantaloni cu snur barbati</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {posts.map((p) => (
        <article class="rounded-md border border-ink/10 bg-white p-5">
          <h2 class="font-bold leading-6"><a href={`/blog/${p.frontmatter.slug}`}>{p.frontmatter.title}</a></h2>
          <p class="mt-2 text-sm leading-6 text-ink/65">{p.frontmatter.metaDescription}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
