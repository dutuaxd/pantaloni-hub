---
import Layout from '../layouts/Layout.astro';
const title = 'Pantaloni cu snur lung si scurti | AXD pantaloni cu snur lun';
const description = 'Pantaloni cu snur lung, pantaloni cu snur lung si variante scurte pentru vara, informatii clare si optiuni utile pentru cumparare. Vezi detalii acum!';
const canonical = 'https://atelieraxd.ro/pantaloni-scurti/';
const schema = { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
<section class="bg-white border-b border-ink/10">
  <div class="section grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
    <div>
      <p class="eyebrow">pantaloni cu snur lung</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-black leading-tight md:text-6xl">Pantaloni cu snur lung si variante scurte pentru vara</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-ink/70">O pagina separata pentru clientii care cauta pantaloni scurti cu talie reglabila, dar cu legaturi interne catre colectia principala.</p>
      <div class="mt-7 flex flex-wrap gap-3"><a class="btn-primary" href="/pantaloni-lungi">Pantaloni cu snur lung</a><a class="btn-secondary" href="/blog">Ghiduri si idei</a></div>
    </div>
    <figure class="overflow-hidden rounded-md border border-ink/10 bg-mist">
      <img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung in tinuta casual clara si moderna" title="Pantaloni cu snur lung" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full object-cover" />
      <figcaption class="px-4 py-3 text-sm text-ink/65">Pantaloni cu snur lung prezentati natural pentru inspiratie de stil.</figcaption>
    </figure>
  </div>
</section>
<section class="section"><div class="mb-8 flex items-end justify-between gap-4"><div><p class="eyebrow">colectie</p><h2 class="text-3xl font-black">Alege rapid modelul potrivit</h2></div><a class="btn-secondary" href="/contact">Intreaba despre stoc</a></div><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Pantaloni scurti negri pentru tinute casual" title="Pantaloni cu snur lung 1" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Pantaloni scurti negri</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Pantaloni scurti casual pentru tinute casual" title="Pantaloni cu snur lung 2" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Pantaloni scurti casual</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Pantaloni scurti sport pentru tinute casual" title="Pantaloni cu snur lung 3" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Pantaloni scurti sport</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Pantaloni scurti unisex pentru tinute casual" title="Pantaloni cu snur lung 4" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Pantaloni scurti unisex</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article></div></section><section class="bg-ink text-white"><div class="section grid gap-8 md:grid-cols-[.8fr_1.2fr]"><h2 class="text-3xl font-black">Scurt sau lung?</h2><p class="text-lg leading-8 text-white/75">Pantaloni cu snur lung sunt mai versatili pentru oras si sezoane diferite, iar modelele scurte sunt mai potrivite pentru caldura si vacante.</p></div></section>
</Layout>
