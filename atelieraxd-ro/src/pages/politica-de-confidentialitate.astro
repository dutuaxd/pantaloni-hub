---
import Layout from '../layouts/Layout.astro';
const title = 'GDPR pantaloni cu snur lung Atelieraxd';
const description = 'Pantaloni cu snur lung, politica gdpr pentru pantaloni cu snur lung, informatii clare si optiuni utile pentru cumparare. Vezi detalii acum!';
const canonical = 'https://atelieraxd.ro/politica-de-confidentialitate/';
const schema = { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
<section class="bg-white border-b border-ink/10">
  <div class="section grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
    <div>
      <p class="eyebrow">pantaloni cu snur lung</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-black leading-tight md:text-6xl">Politica GDPR pentru pantaloni cu snur lung</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-ink/70">Informatii despre operator, date procesate, scopuri si perioade de retentie.</p>
      <div class="mt-7 flex flex-wrap gap-3"><a class="btn-primary" href="/pantaloni-lungi">Pantaloni cu snur lung</a><a class="btn-secondary" href="/blog">Ghiduri si idei</a></div>
    </div>
    <figure class="overflow-hidden rounded-md border border-ink/10 bg-mist">
      <img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung in tinuta casual clara si moderna" title="Pantaloni cu snur lung" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full object-cover" />
      <figcaption class="px-4 py-3 text-sm text-ink/65">Pantaloni cu snur lung prezentati natural pentru inspiratie de stil.</figcaption>
    </figure>
  </div>
</section>
<section class="section"><div class="grid gap-4 md:grid-cols-3"><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Operator date</h2><p class="mt-3 leading-7 text-ink/70">Operator: [PLACEHOLDER_FIRMA]. Contact: contact@example.ro.</p></article><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Retentie</h2><p class="mt-3 leading-7 text-ink/70">Datele fiscale se pastreaza conform legii, iar mesajele de contact cat timp este necesar raspunsului.</p></article><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Drepturi GDPR</h2><p class="mt-3 leading-7 text-ink/70">Ai drept de acces, rectificare, stergere, restrictionare si opozitie.</p></article></div></section>
</Layout>
