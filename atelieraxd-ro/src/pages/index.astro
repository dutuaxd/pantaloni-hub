---
import Layout from '../layouts/Layout.astro';

const title = 'Pantaloni barbati casual cu snur | Atelier AXD';
const description = 'Pantaloni barbati casual, cu snur, largi, negri sau scurti. Alege modele comode pentru tinute streetwear, vara si zi de zi.';
const canonical = 'https://atelieraxd.ro/';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Atelier AXD',
  url: canonical,
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://atelieraxd.ro/blog/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

const categoryCards = [
  {
    title: 'Pantaloni cu snur barbati',
    text: 'Talie reglabila, croieli lejere si modele usor de purtat in tinute casual sau streetwear.',
    href: '/pantaloni-lungi',
  },
  {
    title: 'Pantaloni scurti barbati',
    text: 'Modele pentru vara, vacanta si tinute relaxate, cu focus pe confort si bumbac.',
    href: '/pantaloni-scurti',
  },
  {
    title: 'Pantaloni largi barbati',
    text: 'Croieli oversized, wide leg si relaxed fit pentru outfituri moderne, fara aspect fortat.',
    href: '/pantaloni-lungi#pantaloni-largi',
  },
  {
    title: 'Pantaloni casual barbati',
    text: 'Piese de zi cu zi care pot inlocui pantalonii de trening clasici in tinute mai curate.',
    href: '/pantaloni-lungi#pantaloni-casual',
  },
];

const keywordClusters = [
  'pantaloni barbati',
  'pantaloni barbatesti',
  'pantaloni scurti barbati',
  'pantaloni casual barbati',
  'pantaloni cargo barbati',
  'pantaloni largi barbati',
  'pantaloni cu snur barbati',
  'pantaloni barbati cu siret',
  'pantaloni oversized barbati',
  'pantaloni streetwear barbati',
  'pantaloni wide leg barbati',
  'pantaloni negri barbati',
];
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <section class="bg-white border-b border-ink/10">
    <div class="section grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
      <div>
        <p class="eyebrow">pantaloni barbati casual</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-black leading-tight md:text-6xl">Pantaloni barbati cu snur, largi si casual</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-ink/70">Atelier AXD grupeaza modele de pantaloni barbatesti pentru tinute relaxate: pantaloni cu snur, pantaloni scurti barbati, variante negre, croieli largi, oversized si streetwear.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn-primary" href="/pantaloni-lungi">Vezi pantaloni barbati</a>
          <a class="btn-secondary" href="/pantaloni-scurti">Pantaloni scurti barbati</a>
        </div>
      </div>
      <figure class="overflow-hidden rounded-md border border-ink/10 bg-mist">
        <img src="/og-pantaloni-cu-snur-lung.jpg" alt="pantaloni barbati casual cu snur in tinuta moderna" title="Pantaloni barbati casual cu snur" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full object-cover" />
        <figcaption class="px-4 py-3 text-sm text-ink/65">Pantaloni barbati cu talie reglabila, potriviti pentru tinute casual si streetwear.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="mb-8 max-w-3xl">
      <p class="eyebrow">categorii cautate</p>
      <h2 class="text-3xl font-black">Cauta dupa intentie, nu doar dupa nume</h2>
      <p class="mt-4 leading-7 text-ink/70">Exporturile KWFinder arata ca oamenii cauta atat pagini comerciale generale, precum pantaloni barbati si pantaloni barbatesti, cat si intentii specifice: pantaloni scurti barbati, pantaloni casual barbati, pantaloni largi barbati sau pantaloni barbati cu siret.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {categoryCards.map((card) => (
        <article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm">
          <h2 class="text-xl font-bold"><a href={card.href}>{card.title}</a></h2>
          <p class="mt-3 leading-7 text-ink/70">{card.text}</p>
          <a class="mt-5 inline-flex font-semibold text-clay" href={card.href}>Vezi categoria</a>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-ink text-white">
    <div class="section grid gap-8 md:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="eyebrow text-white/60">seo hub</p>
        <h2 class="text-3xl font-black">Hub pentru pantaloni barbati</h2>
      </div>
      <div class="grid gap-3 text-sm text-white/80 sm:grid-cols-2">
        {keywordClusters.map((keyword) => (
          <a class="rounded-md border border-white/10 px-4 py-3 hover:bg-white/10" href={keyword.includes('scurti') ? '/pantaloni-scurti' : '/pantaloni-lungi'}>{keyword}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="grid gap-6 lg:grid-cols-3">
      <article class="lg:col-span-2">
        <p class="eyebrow">cum alegi</p>
        <h2 class="text-3xl font-black">Pantaloni barbati pentru tinute de zi cu zi</h2>
        <p class="mt-4 leading-8 text-ink/70">Pentru cautari comerciale mari, pagina principala trebuie sa explice rapid diferenta dintre pantaloni casual, pantaloni cu snur, pantaloni largi si variantele scurte. Daca vrei confort, cauta talie reglabila si material placut. Daca vrei tinuta urbana, cauta croieli relaxed, wide leg sau oversized. Daca vrei versatilitate, pantalonii negri barbati si modelele bej, gri sau bleumarin sunt usor de combinat cu tricouri si hanorace.</p>
        <p class="mt-4 leading-8 text-ink/70">Pantalonii de trening barbati au volum mare in cautari, dar nu orice pantalon comod trebuie prezentat ca trening. Pentru o imagine mai curata, alege pantaloni casual cu snur sau cu siret, care pastreaza confortul dar pot arata mai bine in oras, in vacanta sau in tinute streetwear.</p>
      </article>
      <aside class="rounded-md border border-ink/10 bg-white p-6">
        <h2 class="text-xl font-bold">Linkuri rapide</h2>
        <nav class="mt-4 grid gap-3 text-sm font-semibold">
          <a href="/pantaloni-lungi">Pantaloni cu snur barbati</a>
          <a href="/pantaloni-lungi#pantaloni-largi">Pantaloni largi barbati</a>
          <a href="/pantaloni-scurti">Pantaloni scurti barbati</a>
          <a href="/blog/451-bumbac-vs-poliester">Bumbac vs poliester</a>
          <a href="/blog/483-ce-inseamna-regular-fit">Ce inseamna regular fit</a>
        </nav>
      </aside>
    </div>
  </section>
</Layout>
