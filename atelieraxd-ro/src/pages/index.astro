---
import Layout from '../layouts/Layout.astro';
const title = 'Pantaloni cu snur lung ieftini | Atelieraxd pantaloni cu snu';
const description = 'Pantaloni cu snur lung, pantaloni cu snur lung ieftini pentru tinute casual, informatii clare si optiuni utile pentru cumparare. Vezi detalii acum!';
const canonical = 'https://atelieraxd.ro/';
const schema = { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
<section class="bg-white border-b border-ink/10">
  <div class="section grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
    <div>
      <p class="eyebrow">pantaloni cu snur lung</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-black leading-tight md:text-6xl">Pantaloni cu snur lung ieftini pentru tinute casual</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-ink/70">Atelieraxd aduna modele simple, comode si usor de purtat: pantaloni lungi, pantaloni scurti, tricouri si seturi gandite pentru preturi accesibile.</p>
      <div class="mt-7 flex flex-wrap gap-3"><a class="btn-primary" href="/pantaloni-lungi">Pantaloni cu snur lung</a><a class="btn-secondary" href="/blog">Ghiduri si idei</a></div>
    </div>
    <figure class="overflow-hidden rounded-md border border-ink/10 bg-mist">
      <img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung in tinuta casual clara si moderna" title="Pantaloni cu snur lung" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full object-cover" />
      <figcaption class="px-4 py-3 text-sm text-ink/65">Pantaloni cu snur lung prezentati natural pentru inspiratie de stil.</figcaption>
    </figure>
  </div>
</section>
<section class="section"><div class="grid gap-4 md:grid-cols-3"><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Categorii clare</h2><p class="mt-3 leading-7 text-ink/70">Intra direct in colectia de pantaloni cu snur lung, pantaloni scurti, tricouri sau seturi casual.</p><a class="mt-5 inline-flex font-semibold text-clay" href="/pantaloni-lungi">Vezi pagina</a></article><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Preturi accesibile</h2><p class="mt-3 leading-7 text-ink/70">Folosim pagini rapide, descrieri clare si placeholder-e pentru produse pana la conectarea stocului real.</p><a class="mt-5 inline-flex font-semibold text-clay" href="/plata-si-preturi">Vezi pagina</a></article><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Ghiduri utile</h2><p class="mt-3 leading-7 text-ink/70">Blogul explica materiale, marimi, ingrijire si outfituri pentru pantaloni cu snur lung.</p><a class="mt-5 inline-flex font-semibold text-clay" href="/blog">Vezi pagina</a></article></div></section><section class="section"><div class="mb-8 flex items-end justify-between gap-4"><div><p class="eyebrow">colectie</p><h2 class="text-3xl font-black">Alege rapid modelul potrivit</h2></div><a class="btn-secondary" href="/contact">Intreaba despre stoc</a></div><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Pantaloni cu snur lung negri pentru tinute casual" title="Pantaloni cu snur lung 1" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Pantaloni cu snur lung negri</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Pantaloni cu snur lung largi pentru tinute casual" title="Pantaloni cu snur lung 2" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Pantaloni cu snur lung largi</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Pantaloni cu snur lung bumbac pentru tinute casual" title="Pantaloni cu snur lung 3" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Pantaloni cu snur lung bumbac</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Pantaloni cu snur lung unisex pentru tinute casual" title="Pantaloni cu snur lung 4" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Pantaloni cu snur lung unisex</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article></div></section><section class="bg-ink text-white"><div class="section grid gap-8 md:grid-cols-[.8fr_1.2fr]"><h2 class="text-3xl font-black">De ce merge bine un site Astro pentru Atelieraxd</h2><p class="text-lg leading-8 text-white/75">Fiecare pagina este generata ca HTML static in dist, cu meta, canonical, sitemap si imagini dimensionate. Asta inseamna incarcare rapida pe Cloudflare si indexare mai usoara.</p></div></section>
</Layout>
