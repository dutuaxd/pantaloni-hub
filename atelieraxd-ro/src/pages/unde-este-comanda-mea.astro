---
import Layout from '../layouts/Layout.astro';
const title = 'Tracking pantaloni cu snur lung comanda';
const description = 'Pantaloni cu snur lung, unde este comanda mea cu pantaloni cu snur lung, informatii clare si optiuni utile pentru cumparare. Vezi detalii acum!';
const canonical = 'https://atelieraxd.ro/unde-este-comanda-mea/';
const schema = { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
<section class="bg-white border-b border-ink/10">
  <div class="section grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
    <div>
      <p class="eyebrow">pantaloni cu snur lung</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-black leading-tight md:text-6xl">Unde este comanda mea cu pantaloni cu snur lung</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-ink/70">Pagina pentru orientarea clientilor catre AWB si curieri.</p>
      <div class="mt-7 flex flex-wrap gap-3"><a class="btn-primary" href="/pantaloni-lungi">Pantaloni cu snur lung</a><a class="btn-secondary" href="/blog">Ghiduri si idei</a></div>
    </div>
    <figure class="overflow-hidden rounded-md border border-ink/10 bg-mist">
      <img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung in tinuta casual clara si moderna" title="Pantaloni cu snur lung" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full object-cover" />
      <figcaption class="px-4 py-3 text-sm text-ink/65">Pantaloni cu snur lung prezentati natural pentru inspiratie de stil.</figcaption>
    </figure>
  </div>
</section>
<section class="section"><div class="grid gap-4 md:grid-cols-3"><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">FAN Courier</h2><p class="mt-3 leading-7 text-ink/70">Introdu AWB-ul primit pe email sau SMS pe platforma FAN Courier.</p></article><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Cargus</h2><p class="mt-3 leading-7 text-ink/70">Verifica statusul coletului in pagina Cargus folosind codul AWB.</p></article><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">DPD Romania</h2><p class="mt-3 leading-7 text-ink/70">Pentru DPD Romania, foloseste numarul de expediere primit dupa confirmare.</p></article></div></section>
</Layout>
