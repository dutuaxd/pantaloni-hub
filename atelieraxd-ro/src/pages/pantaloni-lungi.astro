---
import Layout from '../layouts/Layout.astro';
const title = 'Pantaloni cu snur lung | Colectie Atelieraxd pantaloni cu sn';
const description = 'Pantaloni cu snur lung, colectie de pantaloni cu snur lung, informatii clare si informatii utile despre produse. Vezi informatiile actualizate.';
const canonical = 'https://atelieraxd.ro/pantaloni-lungi/';
const schema = { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
<section class="bg-white border-b border-ink/10">
  <div class="section grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
    <div>
      <p class="eyebrow">pantaloni cu snur lung</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-black leading-tight md:text-6xl">Colectie de pantaloni cu snur lung</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-ink/70">Modele lejere, talie reglabila, detalii clare si selectie pregatita pentru produse reale.</p>
      <div class="mt-7 flex flex-wrap gap-3"><a class="btn-primary" href="/pantaloni-lungi">Pantaloni cu snur lung</a><a class="btn-secondary" href="/blog">Ghiduri si idei</a></div>
    </div>
    <figure class="overflow-hidden rounded-md border border-ink/10 bg-mist">
      <img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung in tinuta casual clara si moderna" title="Pantaloni cu snur lung" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full object-cover" />
      <figcaption class="px-4 py-3 text-sm text-ink/65">Pantaloni cu snur lung prezentati natural pentru inspiratie de stil.</figcaption>
    </figure>
  </div>
</section>
<section class="section"><div class="mb-8 flex items-end justify-between gap-4"><div><p class="eyebrow">colectie</p><h2 class="text-3xl font-black">Alege rapid modelul potrivit</h2></div><a class="btn-secondary" href="/contact">Intreaba despre stoc</a></div><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Model casual negru pentru tinute casual" title="Pantaloni cu snur lung 1" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Model casual negru</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Model oversized unisex pentru tinute casual" title="Pantaloni cu snur lung 2" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Model oversized unisex</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Model slim cu snur lung pentru tinute casual" title="Pantaloni cu snur lung 3" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Model slim cu snur lung</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Model bumbac pentru vara pentru tinute casual" title="Pantaloni cu snur lung 4" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Model bumbac pentru vara</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Model larg streetwear pentru tinute casual" title="Pantaloni cu snur lung 5" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Model larg streetwear</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Model basic zilnic pentru tinute casual" title="Pantaloni cu snur lung 6" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Model basic zilnic</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Model sport relaxat pentru tinute casual" title="Pantaloni cu snur lung 7" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Model sport relaxat</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article><article class="rounded-md border border-ink/10 bg-white"><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung Model premium placeholder pentru tinute casual" title="Pantaloni cu snur lung 8" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"><div class="p-5"><h3 class="font-bold">Model premium placeholder</h3><p class="mt-2 text-sm text-ink/65">Croiala lejera, talie reglabila si material confortabil.</p><p class="mt-3 font-black">de la [PLACEHOLDER_PRET]</p></div></article></div></section><section class="section"><div class="grid gap-4 md:grid-cols-3"><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Cum alegi marimea</h2><p class="mt-3 leading-7 text-ink/70">Masoara talia si lungimea interioara, apoi compara cu ghidul din FAQ.</p></article><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Materiale comode</h2><p class="mt-3 leading-7 text-ink/70">Bumbacul si amestecurile elastice sunt variante cautate pentru pantaloni cu snur lung.</p></article><article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Livrare si retur</h2><p class="mt-3 leading-7 text-ink/70">Pagina include zone dedicate pentru retur, schimb si urmarirea comenzii.</p></article></div></section>
</Layout>
