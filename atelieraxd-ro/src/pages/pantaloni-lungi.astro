---
import Layout from '../layouts/Layout.astro';
const title = 'Pantaloni cu snur lung | Colectie Atelieraxd pantaloni cu ';
const description = 'Ghid practic despre pantaloni cu snur lung, pantaloni cu snur lung | colectie atelieraxd. Alege modelul potrivit azi!';
const canonical = 'https://atelieraxd.ro/pantaloni-lungi/';
const schema = { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
<section class="bg-white"><div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-[1.1fr_.9fr]"><div><p class="font-semibold text-clay">pantaloni cu snur lung</p><h1 class="mt-3 text-4xl font-bold leading-tight md:text-5xl">Colectie de pantaloni cu snur lung</h1><p class="mt-5 text-lg text-ink/75">Pantaloni cu snur lung pentru tinute comode, preturi accesibile si alegeri rapide, explicate clar in limba romana.</p><a class="mt-6 inline-flex rounded bg-ink px-5 py-3 font-semibold text-white" href="/pantaloni-lungi">Vezi pantaloni cu snur lung</a></div><figure><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung in tinuta casual moderna" title="Pantaloni cu snur lung" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full rounded object-cover"/><figcaption class="mt-2 text-sm text-ink/60">Pantaloni cu snur lung pentru inspiratie de stil casual.</figcaption></figure></div></section><section class="mx-auto max-w-6xl px-4 py-12"><div class="grid gap-4 md:grid-cols-4"><article class="rounded border bg-white p-5"><h2 class="font-bold">pantaloni lungi cu pantaloni cu snur lung</h2><p class="mt-2 text-sm text-ink/70">Selectii accesibile si usor de purtat.</p></article><article class="rounded border bg-white p-5"><h2 class="font-bold">pantaloni scurti cu pantaloni cu snur lung</h2><p class="mt-2 text-sm text-ink/70">Selectii accesibile si usor de purtat.</p></article><article class="rounded border bg-white p-5"><h2 class="font-bold">tricouri cu pantaloni cu snur lung</h2><p class="mt-2 text-sm text-ink/70">Selectii accesibile si usor de purtat.</p></article><article class="rounded border bg-white p-5"><h2 class="font-bold">seturi cu pantaloni cu snur lung</h2><p class="mt-2 text-sm text-ink/70">Selectii accesibile si usor de purtat.</p></article></div></section>
</Layout>
