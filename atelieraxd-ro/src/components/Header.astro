---
const links = [
  ["/pantaloni-lungi", "Pantaloni barbati"],
  ["/pantaloni-scurti", "Pantaloni scurti barbati"],
  ["/tricouri", "Tricouri"],
  ["/seturi", "Seturi"],
  ["/blog", "Ghid pantaloni"],
  ["/contact", "Contact"],
];
---
<header class="border-b border-ink/10 bg-white/90 sticky top-0 z-40 backdrop-blur">
<nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
<a href="/" class="font-black text-xl tracking-normal">Atelieraxd</a>
<div class="hidden items-center gap-5 text-sm font-semibold md:flex">{links.map(([href,label]) => <a class="text-ink/75 hover:text-clay" href={href}>{label}</a>)}</div>
<a class="rounded-md bg-ink px-4 py-2 text-sm font-semibold text-white hover:bg-clay" href="/pantaloni-lungi">pantaloni cu snur</a>
</nav>
</header>
