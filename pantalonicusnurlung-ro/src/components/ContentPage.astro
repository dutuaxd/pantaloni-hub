---
import Layout from '../layouts/Layout.astro';
import { SITE, allContentPages, articleSchema, breadcrumbSchema, company, editorialClusters, faqSchema, faqs, organizationSchema, updated, websiteSchema } from '../data/seoSite';
import { publicCopy, publicPage } from '../data/publicCopy';

const { page: rawPage } = Astro.props;
const page = publicPage(rawPage);
const canonical = `${SITE}/${page.slug}/`;
const image = page.image.startsWith('images/') ? `/${page.image}` : page.image.endsWith('.webp') ? `/images/products/${page.image}` : `/${page.image}`;
const articleFaqs = Array.isArray(page.faqs) && page.faqs.length > 0 ? page.faqs : faqs;
const visibleSections = Array.isArray(page.sections) ? page.sections : [];
const keyTakeaways = Array.isArray(page.keyTakeaways) ? page.keyTakeaways.map(publicCopy) : [];
const comparisonRows = Array.isArray(page.comparisonRows) ? page.comparisonRows : [];
const articleImages = Array.isArray(page.images) ? page.images : [];
const relatedLinks = Array.isArray(page.relatedLinks) ? page.relatedLinks : [];
const allPages = allContentPages.map(publicPage);
const currentIndex = allPages.findIndex((item) => item.slug === page.slug);
const previousPage = currentIndex > 0 ? allPages[currentIndex - 1] : null;
const nextPage = currentIndex >= 0 && currentIndex < allPages.length - 1 ? allPages[currentIndex + 1] : null;
const slugTerms = page.slug.split('/').pop()?.split('-').filter((term) => term.length > 3) || [];
const automaticRelated = allPages
  .filter((item) => item.slug !== page.slug)
  .filter((item) => slugTerms.some((term) => item.slug.includes(term)) || item.category === page.category)
  .slice(0, 8);
const mergedRelated = [
  ...relatedLinks.map(([href, label]) => ({ href, label: publicCopy(label) })),
  ...automaticRelated.map((item) => ({ href: `/${item.slug}/`, label: item.h1 })),
].filter((item, index, arr) => arr.findIndex((candidate) => candidate.href === item.href) === index).slice(0, 10);
const tocSections = [
  ['definitie', 'Definitie'],
  ['infobox', 'Infobox'],
  ...visibleSections.slice(0, 7).map(([heading]) => [heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''), heading]),
  ['vezi-si', 'Vezi si'],
  ['intrebari-frecvente', 'Intrebari frecvente'],
];
const isMaterial = /material|textil|bumbac|poliester|vascoza|denim|lana|casmir|softshell|jersey|fleece|satin|in\b/i.test(`${page.h1} ${page.slug}`);
const isBrand = /atelier|brand|nike|adidas|zara|uniqlo|h&m/i.test(`${page.h1} ${page.slug}`);
const infoboxRows = isBrand
  ? [
      ['Tip entitate', 'Brand / actor fashion'],
      ['Tara', page.slug.includes('atelier') ? 'Romania' : 'International'],
      ['Industrie', 'Fashion, imbracaminte, lifestyle'],
      ['Produse', 'Pantaloni, tricouri, hanorace, piese casual'],
      ['Fondatori', page.slug.includes('atelier') ? 'Atelier AXD' : 'Date variabile dupa brand'],
      ['Website oficial', page.slug.includes('atelier') ? 'atelieraxd.ro' : 'Vezi sursele oficiale ale brandului'],
    ]
  : isMaterial
    ? [
        ['Categorie', 'Material / textila'],
        ['Origine', 'Fibra naturala, sintetica sau mix, in functie de subiect'],
        ['Utilizare', 'Haine casual, pantaloni, tricouri, stratificare si intretinere'],
        ['Avantaje', 'Confort, versatilitate si comportament predictibil cand este ales corect'],
        ['Dezavantaje', 'Poate necesita ingrijire specifica si testare pe zona ascunsa'],
        ['Intretinere', 'Respecta eticheta, temperatura joasa si solutii potrivite materialului'],
      ]
    : [
        ['Categorie', page.category || 'Fashion'],
        ['Tip pagina', 'Articol enciclopedic'],
        ['Subiect', page.h1],
        ['Utilizare', 'Documentare, comparatie, inspiratie si navigare intre concepte'],
        ['Actualizare', updated],
        ['Autor', company.author],
      ];
const termLinks = [
  ['/pantaloni-baggy-negri/', 'Baggy'],
  ['/pantaloni-oversized/', 'Oversized'],
  ['/pantaloni-loose-fit/', 'Loose fit'],
  ['/pantaloni-cargo/', 'Cargo'],
  ['/tinute-streetwear/', 'Streetwear'],
  ['/ghiduri/materiale/', 'Materiale'],
  ['/ghiduri/culori/', 'Culori'],
  ['/ingrijire-textile/', 'Ingrijire textile'],
];
const schema = [
  organizationSchema(),
  websiteSchema(),
  articleSchema(page),
  breadcrumbSchema(page.h1, canonical),
  faqSchema(articleFaqs),
];
---
<Layout title={page.title} description={page.description} canonical={canonical} image={image} type="article" schema={schema}>
  <article class="wiki-page">
    <header class="wiki-hero">
      <div class="container wiki-hero-grid">
        <div>
          <nav class="wiki-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Acasa</a>
            <span>/</span>
            <a href={`/${page.category === 'Pantaloni' ? 'pantaloni' : page.category === 'Ghiduri' ? 'ghiduri' : 'fashion'}/`}>{page.category || 'Fashion'}</a>
          </nav>
          <p class="ency-kicker">Pagina enciclopedica · actualizat {updated}</p>
          <h1>{page.h1}</h1>
          <p class="wiki-definition" id="definitie">{page.intro}</p>
          <div class="wiki-meta-row">
            <span>Autor: {company.author}</span>
            <span>Publicat: <time datetime={page.date || '2026-01-01'}>{page.date || '2026-01-01'}</time></span>
            <span>Revizuit: <time datetime={updated}>{updated}</time></span>
          </div>
        </div>
        <figure class="wiki-main-image">
          <img src={image} alt={page.h1} title={page.h1} width="900" height="1100" loading="eager" decoding="async" fetchpriority="high" />
          <figcaption>{page.h1}</figcaption>
        </figure>
      </div>
    </header>

    <section class="wiki-body">
      <div class="container wiki-layout">
        <aside class="wiki-left-nav">
          <strong>Cuprins</strong>
          <nav aria-label="Cuprins articol">
            {tocSections.map(([href, label]) => <a href={`#${href}`}>{label}</a>)}
          </nav>
        </aside>

        <main class="wiki-main">
          <section class="wiki-summary-box">
            <h2>Pe scurt</h2>
            <p>{page.serpSnippet ? publicCopy(page.serpSnippet) : page.description}</p>
            {keyTakeaways.length > 0 && (
              <ul>
                {keyTakeaways.slice(0, 5).map((item) => <li>{item}</li>)}
              </ul>
            )}
          </section>

          <section class="wiki-infobox" id="infobox">
            <h2>Infobox</h2>
            <dl>
              {infoboxRows.map(([label, value]) => (
                <>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </>
              ))}
            </dl>
          </section>

          {visibleSections.map(([heading, body]) => (
            <section class="wiki-section">
              <h2 id={heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}>{heading}</h2>
              <p>{publicCopy(body)}</p>
            </section>
          ))}

          {comparisonRows.length > 0 && (
            <section class="wiki-section">
              <h2>Comparatie rapida</h2>
              <div class="article-table-wrap">
                <table class="article-table">
                  <thead>
                    <tr><th>Criteriu</th><th>Alege asa</th><th>Evita</th></tr>
                  </thead>
                  <tbody>
                    {comparisonRows.map((row) => (
                      <tr>
                        <td>{publicCopy(row[0])}</td>
                        <td>{publicCopy(row[1])}</td>
                        <td>{publicCopy(row[2])}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}

          {articleImages.length > 0 && (
            <section class="wiki-section">
              <h2>Imagine principala si galerie</h2>
              <div class="wiki-gallery">
                {articleImages.slice(0, 6).map((item) => (
                  <figure>
                    <img src={`/${item.file}`} alt={item.alt} title={item.title || item.alt} width="800" height="1000" loading="lazy" decoding="async" />
                    <figcaption>{publicCopy(item.alt)}</figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )}

          <section class="wiki-section" id="vezi-si">
            <h2>Vezi si</h2>
            <div class="wiki-related-grid">
              {mergedRelated.slice(0, 8).map((item) => <a href={item.href}>{item.label}</a>)}
            </div>
          </section>

          <section class="wiki-section">
            <h2>Termeni asociati</h2>
            <div class="wiki-term-grid">
              {termLinks.map(([href, label]) => <a href={href}>{label}</a>)}
            </div>
          </section>

          <section class="wiki-section">
            <h2>Surse si metodologie editoriala</h2>
            <p>Pagina este construita ca material informativ, pe baza taxonomiei interne PSL, a relatiilor dintre articole, a termenilor cautati de utilizatori si a revizuirilor editoriale. Pentru produse sau disponibilitate comerciala se verifica intotdeauna sursa oficiala a comerciantului.</p>
          </section>

          <section class="wiki-section" id="intrebari-frecvente">
            <h2>Intrebari frecvente</h2>
            <div class="faq-list">
              {articleFaqs.slice(0, 6).map(([q, a]) => (
                <details>
                  <summary>{publicCopy(q)}</summary>
                  <p>{publicCopy(a)}</p>
                </details>
              ))}
            </div>
          </section>

          <nav class="wiki-prev-next" aria-label="Navigare intre articole">
            {previousPage && <a href={`/${previousPage.slug}/`}><span>Articol anterior</span><strong>{previousPage.h1}</strong></a>}
            {nextPage && <a href={`/${nextPage.slug}/`}><span>Articol urmator</span><strong>{nextPage.h1}</strong></a>}
          </nav>
        </main>

        <aside class="wiki-sidebar">
          <section>
            <h2>Categorii principale</h2>
            <a href="/pantaloni/">Pantaloni</a>
            <a href="/ghiduri/materiale/">Materiale</a>
            <a href="/ingrijire-textile/">Textile</a>
            <a href="/ghiduri/culori/">Culori</a>
            <a href="/tinute/">Stiluri</a>
          </section>
          <section>
            <h2>Articole conexe</h2>
            {mergedRelated.slice(0, 5).map((item) => <a href={item.href}>{item.label}</a>)}
          </section>
          <section>
            <h2>Pagini populare</h2>
            {editorialClusters.slice(0, 3).flatMap((cluster) => cluster.links.slice(0, 2)).map(([href, label]) => <a href={href}>{label}</a>)}
          </section>
          <section>
            <h2>Termeni populari</h2>
            {termLinks.slice(0, 6).map(([href, label]) => <a href={href}>{label}</a>)}
          </section>
        </aside>
      </div>
    </section>
  </article>
</Layout>
