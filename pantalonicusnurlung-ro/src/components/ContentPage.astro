---
import Layout from '../layouts/Layout.astro';
import { SITE, SHOP, articleSchema, breadcrumbSchema, company, editorialClusters, faqSchema, faqs, galleryImages, organizationSchema, productSchema, updated, websiteSchema } from '../data/seoSite';
import { atelierImages, atelierImagePath } from '../data/atelierImages';
import { publicCopy, publicPage } from '../data/publicCopy';

const { page: rawPage, isHome = false } = Astro.props;
const page = publicPage(rawPage);
const canonical = page.slug ? `${SITE}/${page.slug}/` : `${SITE}/`;
const image = page.image.startsWith('images/') ? `/${page.image}` : page.image.endsWith('.webp') ? `/images/products/${page.image}` : `/${page.image}`;
const title = page.title;
const articleImages = Array.isArray(page.images) ? page.images : [];
const isSummerFashionAuthority = page.articleType === 'summer-fashion-authority';
const hasArticleGallery = articleImages.length > 0;
const isScheduledArticle = hasArticleGallery && !isSummerFashionAuthority;
const keyTakeaways = Array.isArray(page.keyTakeaways) ? page.keyTakeaways.map(publicCopy) : [];
const comparisonRows = Array.isArray(page.comparisonRows) ? page.comparisonRows : [];
const articleFaqs = Array.isArray(page.faqs) && page.faqs.length > 0 ? page.faqs : faqs;
const relatedLinks = Array.isArray(page.relatedLinks) ? page.relatedLinks : [];
const visibleSections = Array.isArray(page.sections) ? page.sections : [];
const tocSections = visibleSections.slice(0, 6);
const fullGalleryImages = [
  ...galleryImages.map(([file, alt]) => ({ file: `/${file}`, alt })),
  ...atelierImages.map((item) => ({ file: `${atelierImagePath}${item.file}`, alt: item.alt })),
];
const schema = [
  organizationSchema(),
  websiteSchema(),
  ...(isHome ? [] : [articleSchema(page), breadcrumbSchema(page.h1, canonical)]),
  ...(isScheduledArticle ? [productSchema(page.h1, SHOP, new URL(image, SITE).href)] : []),
  faqSchema(articleFaqs),
  ...(page.slug === 'galerie-pantaloni-snur-lung'
    ? [{
        '@context': 'https://schema.org',
        '@type': 'ImageGallery',
        name: 'Galerie Pantaloni cu Snur Lung',
        description: page.description,
        url: canonical,
        image: fullGalleryImages.map((item) => ({ '@type': 'ImageObject', url: `${SITE}${item.file}`, name: item.alt, description: item.alt, width: 800, height: 1200 })),
      }]
    : []),
];
---
<Layout title={title} description={page.description} canonical={canonical} image={image} type={isHome ? 'website' : 'article'} schema={schema}>
  <article class="content-article">
    <section class:list={['content-hero', isHome && 'home-hero']}>
      <div class="container hero-grid">
        <div>
          <p class="section-tag">{isHome ? 'pantaloni cu snur lung' : `// actualizat ${updated}`}</p>
          <h1>{page.h1}</h1>
          <p class="direct-answer">{page.intro}</p>
          <div class="hero-actions">
            <a class="btn-primary" href={SHOP} target="_blank" rel="noopener">{isHome ? 'Vezi colectia' : 'Vezi pantalonii cu snur lung'}</a>
            <a class="btn-ghost" href={isHome ? '/ghid-marimi-pantaloni-cu-snur/' : '/galerie-pantaloni-snur-lung/'}>{isHome ? 'Ghid de marimi' : 'Vezi galeria'}</a>
          </div>
          {isHome && (
            <div class="home-offer">
              <span>Atelier AXD</span>
              <strong>Colectie verificata pe magazin</strong>
              <small>Disponibilitatea si conditiile comerciale sunt afisate pe atelieraxd.ro.</small>
            </div>
          )}
        </div>
        <figure class="hero-figure">
          <img src={image} alt={page.h1} title={page.h1} width="1200" height="1600" loading="eager" decoding="async" fetchpriority="high" />
          <figcaption>{page.h1}</figcaption>
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="container content-layout">
        <div class="article-main">
          <aside class="about-box">
            <strong>Despre acest articol</strong>
            <span>Autor: {company.author}</span>
            <span>Publicat: <time datetime={page.date || '2026-01-01'}>{page.date || '2026-01-01'}</time></span>
            <span>Actualizat: <time datetime={updated}>{updated}</time></span>
          </aside>

          {isHome && (
            <>
              <h2>De ce snurul lung?</h2>
              <ul class="check-list">
                <li>Adauga un accent vizual imediat, fara imprimeuri sau logo-uri mari.</li>
                <li>Functioneaza in tinute unisex, moda urbana si casual.</li>
                <li>Regleaza talia si pastreaza o silueta relaxata.</li>
                <li>Se observa bine in poze si in continut de inspiratie moda.</li>
              </ul>
              <h2>Categorii principale</h2>
              <div class="mini-grid">
                {['barbati', 'femei', 'unisex', 'negri', 'bumbac', 'stil-urban'].map((item) => (
                  <a class="mini-card" href={`/pantaloni-cu-snur-lung-${item}/`}>Pantaloni cu snur lung {item}</a>
                ))}
              </div>
            </>
          )}

          {(page.serpSnippet || keyTakeaways.length > 0 || tocSections.length > 2) && (
            <section class="serp-brief">
              <h2>Pe scurt</h2>
              {page.serpSnippet && <p>{publicCopy(page.serpSnippet)}</p>}
              {keyTakeaways.length > 0 && (
                <ul class="check-list">
                  {keyTakeaways.map((item) => <li>{item}</li>)}
                </ul>
              )}
              {tocSections.length > 2 && (
                <nav class="article-toc" aria-label="Cuprins articol">
                  {tocSections.map(([heading]) => <a href={`#${heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`}>{heading}</a>)}
                </nav>
              )}
            </section>
          )}

          {visibleSections.map(([heading, body]) => (
            <section>
              <h2 id={heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}>{heading}</h2>
              <p>{body}</p>
              <p>Continua lectura prin <a href="/pantaloni-baggy-negri/">ghidul pentru pantaloni baggy negri</a>, analiza despre <a href="/pantaloni-oversized/">croieli oversized</a> si pagina de <a href="/pantaloni-loose-fit/">pantaloni loose fit</a>.</p>
            </section>
          ))}

          {comparisonRows.length > 0 && (
            <section>
              <h2>Comparatie rapida pentru decizie</h2>
              <div class="article-table-wrap">
                <table class="article-table">
                  <thead>
                    <tr>
                      <th>Criteriu</th>
                      <th>Alege asa</th>
                      <th>Evita</th>
                    </tr>
                  </thead>
                  <tbody>
                    {comparisonRows.map((row) => (
                      <tr>
                        <td>{publicCopy(row[0])}</td>
                        <td>{publicCopy(row[1])}</td>
                        <td>{publicCopy(row[2])}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}

          {relatedLinks.length > 0 && (
            <section class="related-guides">
              <h2>Ghiduri conexe fara suprapunere</h2>
              <div class="related-link-grid">
                {relatedLinks.map(([href, label]) => (
                  <a href={href}>{publicCopy(label)}</a>
                ))}
              </div>
            </section>
          )}

          {isScheduledArticle && (
            <section class="scheduled-guide-pack">
              <h2>Comparatie rapida pentru alegere</h2>
              <div class="article-table-wrap">
                <table class="article-table">
                  <thead>
                    <tr>
                      <th>Criteriu</th>
                      <th>Alege asa</th>
                      <th>Evita</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>Fit</td>
                      <td>Croiala relaxata, talie clara, snur vizibil</td>
                      <td>Volum fara structura sau tiv prea lung</td>
                    </tr>
                    <tr>
                      <td>Culoare</td>
                      <td>Negru, gri, bej, maro sau bleumarin</td>
                      <td>Prea multe accente intr-o singura tinuta</td>
                    </tr>
                    <tr>
                      <td>Styling</td>
                      <td>Tricou simplu, hanorac compact, sneakers curati</td>
                      <td>Logo-uri mari peste tot si proportii neclare</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="reader-question">
                <strong>Intrebare pentru cititor</strong>
                <span>Ai purta modelul mai degraba cu tricou oversized sau cu hanorac minimalist?</span>
              </div>
              <div class="social-share-row" aria-label="Urmareste-ne">
                <a href="https://www.instagram.com/?hl=en" target="_blank" rel="noopener">Instagram</a>
                <a href="https://www.facebook.com/profile.php?id=100067635362487" target="_blank" rel="noopener">FB</a>
                <a href="https://ro.pinterest.com/ATELIERAXD/" target="_blank" rel="noopener">Pinterest</a>
                <a href="https://www.tiktok.com/@atelieraxd" target="_blank" rel="noopener">TikTok</a>
              </div>
            </section>
          )}

          {hasArticleGallery && (
            <section>
              <h2>Galerie vizuala pentru articol</h2>
              <div class="gallery-grid article-image-grid">
                {articleImages.map((item) => (
                  <figure>
                    <img src={`/${item.file}`} alt={item.alt} title={item.title || item.alt} width="800" height="1200" loading="lazy" decoding="async" />
                    <figcaption>{publicCopy(item.alt)}</figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )}

          <div class="cta-strip">
            <h2>Colectia comerciala este pe Atelier AXD</h2>
            <p>Pantalonicusnurlung.ro este site informativ. Pentru produse, marimi disponibile si comanda, intra pe atelieraxd.ro.</p>
            <a class="btn-primary" href={SHOP} target="_blank" rel="noopener">vezi pantalonii pe atelieraxd.ro</a>
          </div>

          {page.slug === 'galerie-pantaloni-snur-lung' && (
            <div class="gallery-grid">
              {fullGalleryImages.map(({ file, alt }) => (
                <figure>
                  <img src={file} alt={alt} title={alt} width="800" height="1200" loading="lazy" decoding="async" />
                  <figcaption>{alt}</figcaption>
                </figure>
              ))}
            </div>
          )}

          <h2>Intrebari frecvente despre pantaloni cu snur lung</h2>
          <div class="faq-list">
            {articleFaqs.map(([q, a]) => (
              <details>
                <summary>{publicCopy(q)}</summary>
                <p>{publicCopy(a)}</p>
              </details>
            ))}
          </div>
        </div>
        <aside class="article-side">
          <h2>Ghiduri recomandate</h2>
          <a href="/ce-sunt-pantalonii-cu-snur-lung/">Ce sunt pantalonii cu snur lung?</a>
          <a href="/ghid-alegere-pantaloni-snur-lung/">Ghid alegere</a>
          <a href="/blog/cum-faci-nod-snur-pantaloni/">Cum faci nod la snur</a>
          <a href="/blog/trenduri-urbane-pantaloni-2026/">Trenduri moda urbana 2026</a>
          {editorialClusters[0].links.slice(0, 3).map(([href, label]) => <a href={href}>{label}</a>)}
          <a href={SHOP} target="_blank" rel="noopener">Vezi colectia Atelier AXD</a>
          <address>{company.name}<br />{company.cui}</address>
        </aside>
      </div>
    </section>
  </article>
</Layout>
