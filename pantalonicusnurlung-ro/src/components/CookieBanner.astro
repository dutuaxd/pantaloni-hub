<div id="cookie-banner" class="cookie-panel hidden"><p>Folosim cookie-uri esentiale pentru functionarea site-ului. Tracking-ul nu porneste fara consimtamant.</p><div class="cookie-actions"><button id="accept-cookies" class="cookie-accept">Accept</button><button id="reject-cookies" class="cookie-reject">Refuz</button></div></div><script is:inline>const b=document.getElementById('cookie-banner');if(!localStorage.getItem('axd_consent')) b?.classList.remove('hidden');document.getElementById('accept-cookies')?.addEventListener('click',()=>{localStorage.setItem('axd_consent','accepted');b?.remove();});document.getElementById('reject-cookies')?.addEventListener('click',()=>{localStorage.setItem('axd_consent','rejected');b?.remove();});</script>