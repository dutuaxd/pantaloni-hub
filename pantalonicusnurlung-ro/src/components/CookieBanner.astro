<div id="cookie-banner" class="fixed inset-x-4 bottom-4 z-50 hidden rounded bg-white p-4 shadow-xl md:left-auto md:max-w-md"><p class="text-sm">Folosim cookie-uri esentiale pentru functionarea site-ului. Tracking-ul nu porneste fara consimtamant.</p><div class="mt-3 flex gap-2"><button id="accept-cookies" class="rounded bg-ink px-4 py-2 text-sm text-white">Accept</button><button id="reject-cookies" class="rounded border px-4 py-2 text-sm">Refuz</button></div></div><script>const b=document.getElementById('cookie-banner');if(!localStorage.getItem('axd_consent')) b?.classList.remove('hidden');document.getElementById('accept-cookies')?.addEventListener('click',()=>{localStorage.setItem('axd_consent','accepted');b?.remove();});document.getElementById('reject-cookies')?.addEventListener('click',()=>{localStorage.setItem('axd_consent','rejected');b?.remove();});</script>