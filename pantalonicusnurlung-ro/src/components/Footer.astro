---
import { company } from '../data/seoSite';

const legalLinks = [
  ['/termeni-si-conditii/', 'Termeni si conditii'],
  ['/politica-de-confidentialitate/', 'Confidentialitate'],
  ['/politica-retur/', 'Retur'],
  ['/politica-rambursare/', 'Rambursare'],
  ['/politica-livrare/', 'Livrare'],
  ['/politica-cookies/', 'Cookies'],
  ['/preferinte-cookie/', 'Preferinte cookies'],
  ['/solutionarea-litigiilor/', 'SAL / SOL'],
  ['/contact/', 'Contact'],
];
---

<footer class="simple-footer">
  <div class="container simple-footer-inner">
    <div class="simple-footer-brand">
      <a href="/" class="simple-footer-logo">PSL Fashion</a>
      <p>{company.name} · CUI {company.cui} · Reg. Com. {company.reg}</p>
      <p>{company.address}</p>
    </div>

    <nav class="simple-footer-links" aria-label="Linkuri legale">
      {legalLinks.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <div class="simple-footer-bottom">
      <span>ANPC: Protectia consumatorilor</span>
      <span>Solutionarea alternativa si online a litigiilor</span>
      <a href={`mailto:${company.email}`}>{company.email}</a>
    </div>
  </div>
</footer>
