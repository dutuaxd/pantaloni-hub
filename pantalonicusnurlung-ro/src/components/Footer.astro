---
import { ATELIER_HOME, ATELIER_LINKS, SHOP, editorialClusters, scheduledTopics } from '../data/seoSite';

const socials = [
  ['https://www.instagram.com/atelieraxd.ro/', 'Instagram', '<svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><path d="M17 7h.01"></path></svg>'],
  ['https://www.tiktok.com/@atelieraxd', 'TikTok', '<svg viewBox="0 0 24 24"><path d="M14 4v10.5a4.5 4.5 0 1 1-4.5-4.5"></path><path d="M14 4c1 3 3 5 6 5"></path></svg>'],
  ['https://www.youtube.com/@atelieraxd', 'YouTube', '<svg viewBox="0 0 24 24"><path d="M4 8c0-2 1-3 3-3h10c2 0 3 1 3 3v8c0 2-1 3-3 3H7c-2 0-3-1-3-3V8Z"></path><path d="m10 9 5 3-5 3V9Z"></path></svg>'],
  ['https://www.facebook.com/profile.php?id=100067635362487', 'Facebook', '<svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v4h4v-4h3l1-4h-4V9c0-.6.4-1 1-1Z"></path></svg>'],
];
---
<footer id="footer-contact">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <div class="logo">PantaloniCuSnurLung<span>.ro</span></div>
        <p>Site informativ in romana despre pantaloni baggy, croieli oversized, tinute moda urbana, ghiduri de alegere si trenduri 2026. Pentru produse, stoc si comenzi, traficul merge transparent catre <a href={ATELIER_HOME} target="_blank" rel="noopener">AtelierAXD.ro</a>.</p>
        <div class="social-links">
          {socials.map(([href, label, icon]) => <a href={href} aria-label={label} target="_blank" rel="noopener" set:html={icon}></a>)}
        </div>
      </div>
      <div class="footer-col"><h4>Ghiduri</h4><ul><li><a href="/pantaloni-baggy-negri/">Baggy negri</a></li><li><a href="/pantaloni-oversized/">Oversized</a></li><li><a href="/pantaloni-loose-fit/">Loose fit</a></li><li><a href="/streetwear-barbati/">Streetwear barbati</a></li><li><a href="/streetwear-femei/">Streetwear femei</a></li><li><a href="/blog/">Blog</a></li></ul></div>
      <div class="footer-col"><h4>Site</h4><ul><li><a href="/despre-noi/">Despre noi</a></li><li><a href="/contact/">Contact</a></li><li><a href="/faq/">Intrebari frecvente</a></li><li><a href="/politica-de-confidentialitate/">Politica de confidentialitate</a></li><li><a href="/termeni-si-conditii/">Termeni si conditii</a></li><li><button class="cookie-reset" type="button" data-cookie-reset>Retrage consimtamantul</button></li></ul></div>
      <div class="footer-col"><h4>Atelier AXD</h4><ul><li><a href={SHOP} target="_blank" rel="noopener">Pantaloni barbati</a></li><li><a href={ATELIER_LINKS.tricouri} target="_blank" rel="noopener">Tricouri barbati</a></li><li><a href={ATELIER_LINKS.hanorace} target="_blank" rel="noopener">Hanorace barbati</a></li><li><a href={ATELIER_LINKS.seturi} target="_blank" rel="noopener">Seturi barbati</a></li><li><a href={ATELIER_LINKS.reduceri} target="_blank" rel="noopener">Reduceri</a></li><li><a href={ATELIER_LINKS.blog} target="_blank" rel="noopener">Blog Atelier AXD</a></li></ul></div>
    </div>
    <section class="footer-authority" aria-label="Arhitectura editoriala">
      <div class="footer-trust">
        <span>Publicatie editoriala</span>
        <span>Ghiduri de fit</span>
        <span>Actualizat 2026</span>
        <span>Atelier AXD ecosystem</span>
      </div>
      <div class="footer-clusters">
        {editorialClusters.map((cluster) => (
          <div>
            <h4>{cluster.title}</h4>
            <ul>
              {cluster.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="footer-calendar">
        <h4>Calendar editorial pregatit</h4>
        <p>Publicarea se face gradual, cu rotatie intre ghiduri, comparatii, materiale, outfituri si pagini de intent comercial.</p>
        <div>
          {scheduledTopics.map((topic) => <span>{topic}</span>)}
        </div>
      </div>
      <form class="newsletter-box" action="/blog/" aria-label="Newsletter editorial">
        <h4>Brief editorial</h4>
        <p>Urmareste ghiduri noi despre croieli relaxate, proportii si tinute streetwear.</p>
        <div>
          <input type="email" placeholder="email pentru inspiratie" aria-label="Email newsletter" />
          <button type="submit">Urmareste</button>
        </div>
      </form>
    </section>
    <div class="delivery-payment-box">
      <div class="dp-group">
        <span class="dp-title">Livrare si plata</span>
        <div class="dp-flex">
          <span class="dp-badge">Sameday Courier</span>
          <span class="dp-badge">Easybox Delivery</span>
          <span class="dp-badge">Plata ramburs</span>
          <span class="dp-badge">Card</span>
          <span class="dp-badge">Cash</span>
          <span class="dp-badge">Visa</span>
          <span class="dp-badge">Apple Pay</span>
          <span class="dp-badge">Google Pay</span>
        </div>
      </div>
      <div class="anpc-logos" aria-label="Informatii ANPC">
        <a href="/informatii-legale/" aria-label="Informatii legale ANPC"><img src="/ANPC_logo.avif" alt="ANPC" width="120" height="35" loading="lazy" decoding="async" /></a>
        <a href="/solutionarea-litigiilor/" aria-label="Solutionarea alternativa a litigiilor"><img src="/Solutionarea_online_a_litigiilor_logo.avif" alt="Solutionarea alternativa a litigiilor" width="120" height="35" loading="lazy" decoding="async" /></a>
      </div>
    </div>
    <div class="legal-notice">
      <strong>SC ATELIER AXD SRL</strong> | CUI: 50848938 | Reg. Com: J2024039294009 | Str. Mare A Unirii 4, Bl. 5, Sc. 2, Et. 1, Ap. 17, Focsani, Vrancea | atelieraxd@outlook.com
    </div>
    <div class="footer-bottom"><p>&copy; 2026 pantalonicusnurlung.ro | Site informativ operat de SC ATELIER AXD SRL.</p></div>
  </div>
</footer>
