---
import { ATELIER_LINKS, SHOP } from '../data/seoSite';

const shopLinks = [
  [ATELIER_LINKS.reduceri, 'Reduceri'],
  [ATELIER_LINKS.hanorace, 'Hanorace'],
  [ATELIER_LINKS.tricouri, 'Tricouri'],
  [SHOP, 'Pantaloni'],
  [ATELIER_LINKS.seturi, 'Seturi'],
  [ATELIER_LINKS.copii, 'Copii'],
];

const editorialLinks = [
  ['/blog/', 'Blog'],
  ['/contact/', 'Contact'],
];

const localLinks = [
  ['/pantaloni-baggy-negri/', 'Baggy negru'],
  ['/pantaloni-oversized/', 'Oversized'],
  ['/pantaloni-loose-fit/', 'Loose fit'],
  ['/pantaloni-pe-orase/', 'Orase'],
  ['/ce-sunt-pantalonii-cu-snur-lung/', 'Enciclopedie'],
];
---
<header class="header-wrapper">
  <div class="promo-bar" aria-label="Oferta speciala">
    <a href={SHOP} target="_blank" rel="noopener">
      <span class="promo-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 12v8H4v-8"></path><path d="M2 7h20v5H2z"></path><path d="M12 20V7"></path><path d="M12 7H7.5a2.5 2.5 0 1 1 2-4c1.4 1.8 2.5 4 2.5 4Z"></path><path d="M12 7h4.5a2.5 2.5 0 1 0-2-4c-1.4 1.8-2.5 4-2.5 4Z"></path></svg></span>
      <span>Oferta speciala! Adauga 4 produse in cos si primesti 15% reducere la finalizare.</span>
      <span class="promo-separator" aria-hidden="true"></span>
      <span class="promo-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 12v8H4v-8"></path><path d="M2 7h20v5H2z"></path><path d="M12 20V7"></path><path d="M12 7H7.5a2.5 2.5 0 1 1 2-4c1.4 1.8 2.5 4 2.5 4Z"></path><path d="M12 7h4.5a2.5 2.5 0 1 0-2-4c-1.4 1.8-2.5 4-2.5 4Z"></path></svg></span>
    </a>
  </div>
  <div class="service-bar">
    <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3z"></path><path d="M14 10h4l3 3v3h-7z"></path><path d="M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path><path d="M18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path></svg> Livrare rapida oriunde in Romania</span>
    <span>Suport clienti: <strong>+40 737 101 911</strong> <a href="mailto:atelieraxd@outlook.com">atelieraxd@outlook.com</a></span>
  </div>
  <nav>
    <div class="shop-main">
      <a href="/" class="logo logo-mark" aria-label="Acasa Pantaloni cu snur lung">
        <span class="logo-word"><span class="brand-dark">PANTALONI</span> <span class="brand-accent">CU SNUR LUNG.ro</span></span>
      </a>
      <form class="site-search" action="/search/baggy/" role="search" aria-label="Cauta produse">
        <label for="site-search-input">Cauta</label>
        <input id="site-search-input" type="search" name="q" placeholder="Cauta produse..." />
        <button type="submit">Cauta</button>
      </form>
      <a href={ATELIER_LINKS.partener} class="collab-link" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 12h8"></path><path d="M10 8h4l2 4-4 4-4-4 2-4Z"></path><path d="M3 12l4-4h3"></path><path d="M21 12l-4-4h-3"></path></svg>
        <span>Colaborator</span>
      </a>
    </div>
    <div class="category-nav">
      <ul class="nav-links">
        {shopLinks.map(([href, label]) => <li><a href={href} target="_blank" rel="noopener">{label}</a></li>)}
        {editorialLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        {localLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </div>
  </nav>
</header>
