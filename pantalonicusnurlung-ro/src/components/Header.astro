---
import { SHOP } from '../data/seoSite';

const links = [
  ['/ce-sunt-pantalonii-cu-snur-lung/', 'Ce sunt'],
  ['/ghid-alegere-pantaloni-snur-lung/', 'Ghid alegere'],
  ['/blog/pantaloni-snur-lung-outfit-idei/', 'Tinute'],
  ['/blog/trenduri-urbane-pantaloni-2026/', 'Trenduri'],
  ['/pantaloni-cu-snur-lung-unisex/', 'Unisex'],
  ['/blog/', 'Blog'],
];
---
<header class="header-wrapper">
  <nav>
    <div class="nav-inner">
      <a href="/" class="logo" aria-label="Acasa Pantaloni cu Snur Lung">Pantaloni cu Snur Lung<span>.ro</span></a>
      <ul class="nav-links">
        {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
      <a href={SHOP} class="nav-cta" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Atelier AXD</a>
    </div>
  </nav>
</header>
<div class="fab-left"><a href="mailto:atelieraxd@outlook.com" class="fab-btn fab-email" aria-label="Trimite email catre Atelier AXD"><i class="fa-solid fa-envelope" aria-hidden="true"></i></a></div>
