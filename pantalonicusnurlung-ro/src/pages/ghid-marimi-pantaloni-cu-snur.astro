---
import Layout from '../layouts/Layout.astro';
const title = 'Marimi pantaloni cu snur lung';
const description = 'Pantaloni cu snur lung, ghid marimi pentru pantaloni cu snur lung, informatii clare si optiuni utile pentru cumparare. Vezi detalii acum!';
const canonical = 'https://pantalonicusnurlung.ro/ghid-marimi-pantaloni-cu-snur/';
const schema = { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
<section class="bg-white border-b border-ink/10">
  <div class="section grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
    <div>
      <p class="eyebrow">pantaloni cu snur lung</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-black leading-tight md:text-6xl">Ghid marimi pentru pantaloni cu snur lung</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-ink/70">Tabel de marimi si instructiuni pentru masurarea taliei, soldului si lungimii interioare.</p>
      <div class="mt-7 flex flex-wrap gap-3"><a class="btn-primary" href="/pantaloni-lungi">Pantaloni cu snur lung</a><a class="btn-secondary" href="/blog">Ghiduri si idei</a></div>
    </div>
    <figure class="overflow-hidden rounded-md border border-ink/10 bg-mist">
      <img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung in tinuta casual clara si moderna" title="Pantaloni cu snur lung" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full object-cover" />
      <figcaption class="px-4 py-3 text-sm text-ink/65">Pantaloni cu snur lung prezentati natural pentru inspiratie de stil.</figcaption>
    </figure>
  </div>
</section>
<section class="section"><table class="w-full overflow-hidden rounded-md bg-white text-left shadow-sm"><thead class="bg-ink text-white"><tr><th class="p-4">Marime</th><th class="p-4">Talie</th><th class="p-4">Lungime</th></tr></thead><tbody><tr><td class="p-4">S</td><td class="p-4">70-78 cm</td><td class="p-4">98 cm</td></tr><tr class="bg-mist"><td class="p-4">M</td><td class="p-4">78-86 cm</td><td class="p-4">100 cm</td></tr><tr><td class="p-4">L</td><td class="p-4">86-94 cm</td><td class="p-4">102 cm</td></tr></tbody></table><p class="mt-6"><a class="btn-primary" href="https://atelieraxd.ro/pantaloni-lungi">pantaloni cu snur lung atelieraxd</a></p></section>
</Layout>
