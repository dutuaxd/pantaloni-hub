---
import Layout from '../layouts/Layout.astro';
const title = '404 pantaloni cu snur lung';
const description = 'Ghid practic despre pantaloni cu snur lung, 404 pantaloni cu snur lung. Alege modelul potrivit azi!';
const canonical = 'https://pantalonicusnurlung.ro/404/';
const schema = { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
<section class="bg-white"><div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-[1.1fr_.9fr]"><div><p class="font-semibold text-clay">pantaloni cu snur lung</p><h1 class="mt-3 text-4xl font-bold leading-tight md:text-5xl">Pagina nu a fost gasita pentru pantaloni cu snur lung</h1><p class="mt-5 text-lg text-ink/75">Pantaloni cu snur lung pentru tinute comode, preturi accesibile si alegeri rapide, explicate clar in limba romana.</p><a class="mt-6 inline-flex rounded bg-ink px-5 py-3 font-semibold text-white" href="/pantaloni-lungi">Vezi pantaloni cu snur lung</a></div><figure><img src="/og-pantaloni-cu-snur-lung.jpg" alt="Pantaloni cu snur lung in tinuta casual moderna" title="Pantaloni cu snur lung" width="1200" height="630" loading="eager" fetchpriority="high" class="aspect-[1200/630] w-full rounded object-cover"/><figcaption class="mt-2 text-sm text-ink/60">Pantaloni cu snur lung pentru inspiratie de stil casual.</figcaption></figure></div></section><section class="mx-auto max-w-4xl px-4"><a href="/">Homepage</a> <a href="/pantaloni-lungi">Pantaloni cu snur lung</a></section>
</Layout>
