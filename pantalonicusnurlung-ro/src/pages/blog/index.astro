---
import Layout from '../../layouts/Layout.astro';
const posts = (await Astro.glob('../../content/blog/*/index.md')).filter((p) => !p.frontmatter.draft);
const title = 'Blog pantaloni cu snur lung | Streetwear ghid';
const description = 'Articole despre pantaloni cu snur lung, streetwear, materiale, marimi si styling unisex. Citeste ghidurile acum!';
const canonical = 'https://pantalonicusnurlung.ro/blog/';
const schema = { '@context': 'https://schema.org', '@type': 'Blog', name: title, url: canonical };
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <section id="hero">
    <div class="hero-bg"></div>
    <div class="container">
      <div class="hero-inner-wrapper">
        <div class="hero-content">
          <div class="hero-badge">Ghiduri streetwear</div>
          <h1 class="hero-h1">Blog<br /><span class="line2">pantaloni cu snur lung</span></h1>
          <p class="hero-sub">Articole optimizate SEO despre materiale, croieli, istorie, styling si alegerea perechii potrivite de pantaloni cu snur lung.</p>
          <div class="hero-actions">
            <a href="https://atelieraxd.ro/pantaloni-lungi" class="btn-primary">Vezi colectia</a>
            <a href="/pantaloni-cu-snur-lung" class="btn-ghost">Ghid principal</a>
          </div>
        </div>
        <div class="hero-promo-box">
          <div class="promo-title">Citeste si cumpara</div>
          <div class="promo-big">5</div>
          <div class="promo-highlight">ghiduri</div>
          <div class="promo-desc">Fiecare articol trimite natural catre colectia AtelierAXD.</div>
          <a href="https://atelieraxd.ro/pantaloni-lungi" class="promo-btn">Magazin</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((p) => (
          <article class="blog-card reveal">
            <span class="section-tag">// articol</span>
            <h2><a href={'/blog/' + p.frontmatter.slug}>{p.frontmatter.title}</a></h2>
            <p>{p.frontmatter.metaDescription}</p>
            <a class="btn-ghost" href={'/blog/' + p.frontmatter.slug}>Citeste</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
