---
import Layout from '../layouts/Layout.astro';
import { productSchema, SHOP } from '../data/seoSite';

const title = 'Pantaloni cu snur lung | Ghid moda urbana complet';
const description = 'Ghid complet despre pantaloni cu snur lung, modele cu fermoare, croieli moda urbana, materiale si marimi.';
const canonical = 'https://pantalonicusnurlung.ro/pantaloni-cu-snur-lung/';
const image = '/pantaloni-scurti-gri-100-bumbac-fermoar.png';
const zipperProducts = [
  {
    image: '/pantaloni-scurti-gri-100-bumbac-fermoar.png',
    name: 'Pantaloni scurti gri cu fermoare',
    desc: 'Model scurt cu talie elastica, snur alb lung si fermoare negre aplicate frontal pentru accent vizual puternic.',
    tags: ['100% bumbac', 'Fermoare negre'],
  },
  {
    image: '/pantaloni-maro-snur-lung-fermoare-mijloc.png',
    name: 'Pantaloni maro cu snur lung si fermoare',
    desc: 'Nuanta maro-gri usor spalata, snur lung contrastant si doua fermoare curbe care dau forma tinutei.',
    tags: ['Maro', 'Snur lung'],
  },
  {
    image: '/pantaloni-maro-casual-snur-lung-modern.png',
    name: 'Tinuta casual cu pantaloni cu fermoare',
    desc: 'Purtati cu tricou oversized si sneakers albi, pantalonii cu fermoare merg direct in zona casual urbana.',
    tags: ['Outfit', 'Unisex'],
  },
];
const schema = [
  { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical, image:new URL(image, canonical).href },
  productSchema('Pantaloni scurti gri cu snur lung si fermoare', SHOP, new URL(image, canonical).href),
];
---
<Layout title={title} description={description} canonical={canonical} image={image} type="website" schema={schema}>
  <section id="hero">
    <div class="hero-bg"></div>
    <div class="container">
      <div class="hero-inner-wrapper">
        <div class="hero-content">
          <div class="hero-badge">Ghid urban 2026</div>
          <h1 class="hero-h1">Pantaloni cu<br /><span class="line2">snur lung.</span><br />Ghid complet</h1>
          <p class="hero-sub">Ghidul principal pentru pantaloni cu snur lung: croiala, material, talie elastica, snur vizibil, modele cu fermoare si alegere rapida online.</p>
          <div class="hero-actions">
            <a href={SHOP} class="btn-primary">Vezi colectia</a>
            <a href="/ghid-marimi-pantaloni-cu-snur" class="btn-ghost">Ghid marimi</a>
          </div>
        </div>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><div class="stat-num">100<span>%</span></div><div class="stat-label">Calitate superioara</div></div>
        <div class="hero-stat"><div class="stat-num">Unisex</div><div class="stat-label">Purtat si de femei</div></div>
        <div class="hero-stat"><div class="stat-num">1-3<span>zile</span></div><div class="stat-label">Timp livrare</div></div>
        <div class="hero-stat"><div class="stat-num">Card</div><div class="stat-label">sau ramburs</div></div>
      </div>
    </div>
  </section>

  <section class="section" id="colectie">
    <div class="container">
      <div class="services-header reveal">
        <div>
          <span class="section-tag">// Modele cu snur lung</span>
          <h2 class="section-h2">Alege modelul de <em>pantaloni</em> preferat</h2>
        </div>
        <p class="section-lead">Selectam croieli moda urbana cu accent pe snur lung, talie elastica, materiale comode si detalii vizibile.</p>
      </div>
      <div class="services-grid">
        <a class="service-card reveal" href={SHOP}>
          <div class="service-arrow">-&gt;</div>
          <div class="card-img-wrap"><img src="/pantaloni-barbati-largi-negri-snur-casual.jpg" alt="Pantaloni barbati largi negri snur casual" title="Pantaloni barbati largi negri snur casual" width="1200" height="1600" loading="eager" fetchpriority="high" /></div>
          <div class="service-name">Pantaloni barbati largi negri snur casual</div>
          <div class="service-desc">Croiala lejera potrivita pentru un aspect relaxat. Echilibru intre moda urbana si casual, purtat usor de baieti si fete.</div>
          <div class="service-tags"><span class="tag">Popular</span><span class="tag">Unisex lejer</span></div>
        </a>
        <a class="service-card reveal reveal-delay-1" href={SHOP}>
          <div class="service-arrow">-&gt;</div>
          <div class="card-img-wrap"><img src="/pantaloni-barbati-negri-snur-lung.jpg" alt="Pantaloni barbati negri snur lung" title="Pantaloni barbati negri snur lung" width="1200" height="1600" loading="lazy" decoding="async" /></div>
          <div class="service-name">Pantaloni barbati negri snur lung</div>
          <div class="service-desc">Varianta clasica reinventata, cu material durabil, asezare buna pe incaltaminte sport si snur lung vizibil.</div>
          <div class="service-tags"><span class="tag">Croiala clasica</span><span class="tag">Selectie</span></div>
        </a>
        <a class="service-card reveal" href={SHOP}>
          <div class="service-arrow">-&gt;</div>
          <div class="card-img-wrap"><img src="/pantaloni-scurti-negri-cu-snur-lung.jpg" alt="Pantaloni scurti negri cu snur lung" title="Pantaloni scurti negri cu snur lung" width="1200" height="1600" loading="lazy" decoding="async" /></div>
          <div class="service-name">Pantaloni scurti negri cu snur lung</div>
          <div class="service-desc">Pentru sezonul cald: acelasi impact vizual moda urbana intr-o pereche scurta si confortabila.</div>
          <div class="service-tags"><span class="tag">Vara</span><span class="tag">Scurti</span></div>
        </a>
      </div>
    </div>
  </section>

  <section class="section zipper-section" id="fermoare">
    <div class="container">
      <div class="services-header reveal">
        <div>
          <span class="section-tag">// Fermoare vizibile</span>
          <h2 class="section-h2">Pantaloni cu snur lung si <em>fermoare</em></h2>
        </div>
        <p class="section-lead">Fermoarele negre schimba complet piesa: traseaza linii pe picior, adauga contrast si fac pantalonii mai usor de purtat in outfituri simple cu tricou oversized.</p>
      </div>
      <div class="services-grid zipper-grid">
        {zipperProducts.map((product) => (
          <a class="service-card reveal" href={SHOP}>
            <div class="service-arrow">-&gt;</div>
            <div class="card-img-wrap zipper-img"><img src={product.image} alt={product.name} title={product.name} width="1200" height="1600" loading="lazy" decoding="async" /></div>
            <div class="service-name">{product.name}</div>
            <div class="service-desc">{product.desc}</div>
            <div class="service-tags">{product.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split-grid">
        <article class="content-panel reveal"><h2>Croiala potrivita</h2><p>Pantaloni cu snur lung pot fi loose, oversized, scurti sau slim. Modelele cu fermoare dau volum si atitudine fara imprimeuri mari.</p></article>
        <article class="content-panel reveal"><h2>Detaliu cu fermoar</h2><p>Fermoarul negru pe material gri sau maro creeaza linii verticale care alungesc vizual si fac pantalonul mai usor de remarcat.</p></article>
        <article class="content-panel reveal"><h2>Cum ii porti</h2><p>Merg cu tricouri oversized, sneakers albi, hanorace simple si piese fara grafica puternica, ca fermoarele si snurul sa ramana accentul central.</p></article>
        <article class="content-panel reveal"><h2>Unde ii cumperi</h2><p>Pentru achizitie, butonul principal trimite catre colectia AtelierAXD de pantaloni cu snur lung.</p></article>
      </div>
    </div>
  </section>

  <section class="section" id="lookbook">
    <div class="container">
      <div class="services-header reveal">
        <div><span class="section-tag">// Purtat si de ea</span><h2 class="section-h2">Croiala de barbati? Mai degraba <em>unisex.</em></h2></div>
        <p class="section-lead">Desi multe modele vin din zona moda masculina, croielile lejere, snurul lung si fermoarele vizibile le fac potrivite si pentru tinute feminine relaxate.</p>
      </div>
      <div class="lookbook-grid reveal reveal-delay-1">
        <figure class="lookbook-item"><img src="/pantaloni-maro-casual-snur-lung-modern.png" alt="Tinuta cu pantaloni scurti cu fermoare si snur lung" title="Tinuta cu fermoare" width="1200" height="1600" loading="lazy" decoding="async" /><figcaption class="lookbook-overlay"><span class="lookbook-title">Tinuta cu fermoare</span></figcaption></figure>
        <figure class="lookbook-item"><img src="/pantaloni-scurti-gri-100-bumbac-fermoar.png" alt="Pantaloni scurti gri cu fermoare si snur lung" title="Fermoare negre" width="1200" height="1200" loading="lazy" decoding="async" /><figcaption class="lookbook-overlay"><span class="lookbook-title">Fermoare negre</span></figcaption></figure>
        <figure class="lookbook-item"><img src="/pantaloni-maro-snur-lung-fermoare-mijloc.png" alt="Pantaloni maro cu snur lung si fermoare" title="Maro urban" width="1200" height="1200" loading="lazy" decoding="async" /><figcaption class="lookbook-overlay"><span class="lookbook-title">Maro urban</span></figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="content-panel reveal" style="text-align:center">
        <span class="section-tag">// cumpara acum</span>
        <h2 class="section-h2" style="margin:0 auto 18px">Pantaloni cu snur lung AtelierAXD</h2>
        <p style="max-width:640px;margin:0 auto 26px">Daca ai ales stilul, mergi direct in magazin pentru modele disponibile, plata si livrare.</p>
        <a href={SHOP} class="btn-primary">pantaloni cu snur lung atelieraxd</a>
      </div>
    </div>
  </section>
</Layout>
