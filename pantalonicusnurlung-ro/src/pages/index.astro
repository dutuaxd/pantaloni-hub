---
import Layout from '../layouts/Layout.astro';
import { productImages, productImagePath } from '../data/productImages';
import { SITE, SHOP, faqSchema, faqs, organizationSchema, productSchema, websiteSchema } from '../data/seoSite';

const title = 'Pantaloni baggy si oversized | Moda urbana romanesc 2026';
const description = 'Ghid romanesc pentru pantaloni baggy, joggeri oversized, pantaloni loose fit si outfituri moda urbana cu link transparent catre Atelier AXD.';
const canonical = `${SITE}/`;
const hero = productImages[2];
const img = (index: number) => productImages[index % productImages.length];
const imageUrl = (item: { file: string }) => `${productImagePath}${item.file}`;
const schema = [
  organizationSchema(),
  websiteSchema(),
  faqSchema(),
  productSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: 'Pantaloni cu Snur Lung Atelier AXD',
    url: canonical,
    image: productImages.map((item) => ({
      '@type': 'ImageObject',
      url: `${SITE}${imageUrl(item)}`,
      name: item.title,
      description: item.alt,
      width: 1200,
      height: 1600,
    })),
  },
];

const categories = [
  ['Pantaloni negri', 'Usor de purtat zilnic', img(3)],
  ['Pantaloni bleumarin', 'Look curat, urban, discret', img(6)],
  ['Pantaloni maro', 'Ton cald pentru tinute relaxate', img(9)],
  ['Pantaloni bej', 'Varianta luminoasa pentru vara', img(11)],
];

const benefits = [
  ['<svg viewBox="0 0 24 24"><path d="M4 14c4-6 10-8 16-7-1 7-5 11-12 12l-4 1 1-4Z"></path><path d="M8 16c3-3 6-5 10-7"></path></svg>', 'Confort zilnic', 'Materiale lejere, usor de purtat zilnic.'],
  ['<svg viewBox="0 0 24 24"><path d="M7 8h10l2 4-7 8-7-8 2-4Z"></path><path d="M8 12h8"></path></svg>', 'Croiala actuala', 'Croiala relaxata care ramane relevanta si in 2027.'],
  ['<svg viewBox="0 0 24 24"><path d="M5 7h14M5 12h10M5 17h14"></path></svg>', 'Linie curata', 'Proportii ordonate, fara stilizare incarcata.'],
  ['<svg viewBox="0 0 24 24"><path d="m12 3 8 4-8 4-8-4 8-4Z"></path><path d="m4 12 8 4 8-4"></path><path d="m4 17 8 4 8-4"></path></svg>', 'Versatilitate', 'Merge cu tricou, hanorac sau jacheta minimal.'],
];

const iconBenefits = [
  ['<svg viewBox="0 0 24 24"><path d="M4 14c4-6 10-8 16-7-1 7-5 11-12 12l-4 1 1-4Z"></path></svg>', 'Confort'],
  ['<svg viewBox="0 0 24 24"><path d="M6 12c2-4 5-6 9-6 2 0 3 1 3 3 0 4-4 7-10 9"></path></svg>', 'Actual'],
  ['<svg viewBox="0 0 24 24"><path d="M5 7h14M5 12h10M5 17h14"></path></svg>', 'Linie curata'],
  ['<svg viewBox="0 0 24 24"><path d="m12 4 8 4-8 4-8-4 8-4Z"></path><path d="m4 14 8 4 8-4"></path></svg>', 'Straturi'],
  ['<svg viewBox="0 0 24 24"><path d="M3 7h11v10H3z"></path><path d="M14 11h4l3 3v3h-7z"></path><circle cx="7" cy="18" r="2"></circle><circle cx="18" cy="18" r="2"></circle></svg>', 'Livrare'],
  ['<svg viewBox="0 0 24 24"><path d="m4 8 8-4 8 4-8 4-8-4Z"></path><path d="M4 8v8l8 4 8-4V8"></path><path d="M12 12v8"></path></svg>', 'Ambalare'],
  ['<svg viewBox="0 0 24 24"><path d="M4 10h16l-2-5H6l-2 5Z"></path><path d="M6 10v9h12v-9"></path><path d="M9 19v-5h6v5"></path></svg>', 'Atelier AXD'],
];
---
<Layout title={title} description={description} canonical={canonical} image={imageUrl(hero)} type="website" schema={schema}>
  <section class="landing-hero">
    <div class="landing-shell landing-hero-grid">
      <div class="landing-copy">
        <p class="eyebrow">Ghid moda urbana romanesc</p>
        <h1>Pantaloni baggy, oversized si urban fit pentru 2026.</h1>
        <p>Ghid editorial despre pantaloni casual largi, joggeri oversized, croieli loose fit si tinute moda urbana curate. Produsele si comenzile raman pe Atelier AXD.</p>
        <div class="landing-actions">
          <a class="primary-action" href={SHOP} target="_blank" rel="noopener">Descopera modelele</a>
          <a class="secondary-action" href="/ghid-marimi-pantaloni-cu-snur/">Ghid de marimi</a>
        </div>
        <div class="offer-note">
          <span>Oferta</span>
          <strong>4 produse = 15% reducere</strong>
          <small>Reducerea se aplica in magazinul Atelier AXD.</small>
        </div>
      </div>
      <a class="hero-product-link" href={SHOP} target="_blank" rel="noopener" aria-label={hero.alt}>
        <img src={imageUrl(hero)} alt={hero.alt} title={hero.title} width="1200" height="1600" loading="eager" fetchpriority="high" />
      </a>
    </div>
  </section>

  <section class="proof-band">
    <div class="landing-shell">
      <p>Ghiduri in romana pentru pantaloni baggy, croieli relaxate si tinute moda urbana.</p>
    </div>
  </section>

  <section class="landing-section">
    <div class="landing-shell">
      <h2>Ghid vizual pentru modele esentiale</h2>
      <div class="filter-row">
        <span>Alege tinuta</span><span>Croiala larga</span><span>Unisex</span><span>Moda urbana romaneasca</span>
      </div>
      <div class="product-grid">
        {productImages.slice(0, 4).map((item) => (
          <a class="product-card" href={SHOP} target="_blank" rel="noopener">
            <span class="card-badge">Catre Atelier AXD</span>
            <img src={imageUrl(item)} alt={item.alt} title={item.title} width="800" height="1067" loading="lazy" decoding="async" />
            <small class="stars">2000+ comenzi onorate</small>
            <strong>{item.title}</strong>
            <em>Snur lung contrastant, croiala lejera.</em>
            <span class="card-button">Vezi pe site</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="landing-section soft">
    <div class="landing-shell">
      <h2>Galerie urbana</h2>
      <div class="ugc-grid">
        {productImages.slice(4, 7).map((item) => (
          <a href={SHOP} target="_blank" rel="noopener">
            <img src={imageUrl(item)} alt={item.alt} title={item.title} width="800" height="1067" loading="lazy" decoding="async" />
            <span>{item.title}</span>
          </a>
        ))}
      </div>
      <a class="primary-action center" href={SHOP} target="_blank" rel="noopener">Vezi pe Atelier AXD</a>
    </div>
  </section>

  <section class="icon-row">
    <div class="landing-shell icons">
        {iconBenefits.map(([icon, text]) => (
        <span><b set:html={icon}></b>{text}</span>
      ))}
    </div>
  </section>

  <section class="landing-section">
    <div class="landing-shell split">
      <a class="image-panel" href={SHOP} target="_blank" rel="noopener">
        <img src={imageUrl(img(7))} alt={img(7).alt} title={img(7).title} width="900" height="1200" loading="lazy" decoding="async" />
      </a>
      <div class="text-panel">
        <h2>Detaliu vizual puternic</h2>
        <p>Snurul lung creeaza imediat un centru vizual. Nu ai nevoie de imprimeuri mari sau stilizare complicat: pantalonii devin piesa care da directia tinutei.</p>
        <a class="primary-action" href={SHOP} target="_blank" rel="noopener">Descopera</a>
      </div>
    </div>
  </section>

  <section class="landing-section">
    <div class="landing-shell split reverse">
      <div class="text-panel">
        <h2>Croiala relaxata, look ordonat</h2>
        <p>Croiala relaxata merge in tinute de oras, drum, facultate, munca lejera sau weekend. Modelele sunt usor de purtat cu tricou alb, tricou negru sau hanorac.</p>
        <a class="primary-action" href={SHOP} target="_blank" rel="noopener">Vezi pe Atelier AXD</a>
      </div>
      <a class="image-panel" href={SHOP} target="_blank" rel="noopener">
        <img src={imageUrl(img(8))} alt={img(8).alt} title={img(8).title} width="900" height="1200" loading="lazy" decoding="async" />
      </a>
    </div>
  </section>

  <section class="landing-section soft">
    <div class="landing-shell">
      <h2>Categorii principale</h2>
      <div class="product-grid categories-grid">
        {categories.map(([name, copy, item]) => (
          <a class="product-card" href={SHOP} target="_blank" rel="noopener">
            <img src={imageUrl(item)} alt={item.alt} title={item.title} width="800" height="1067" loading="lazy" decoding="async" />
            <small class="stars">4.9 | Atelier AXD</small>
            <strong>{name}</strong>
            <em>{copy}</em>
            <span class="card-button">Vezi categoria</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="proof-large">
    <div class="landing-shell">
      <h2>Minimal pe culoare, maxim pe impact</h2>
      <div>Snur lung contrastant, talie elastica si volume usor de integrat in tinute urbane.</div>
      <a class="primary-action center" href={SHOP} target="_blank" rel="noopener">Mergi catre magazin</a>
    </div>
  </section>

  <section class="landing-section">
    <div class="landing-shell">
      <h2>Beneficii clare</h2>
      <div class="benefit-grid">
        {benefits.map(([icon, name, body]) => (
          <a href={SHOP} target="_blank" rel="noopener">
            <span class="benefit-svg" set:html={icon}></span>
            <strong>{name}</strong>
            <span>{body}</span>
          </a>
        ))}
      </div>
      <a class="primary-action center" href={SHOP} target="_blank" rel="noopener">Intra pe Atelier AXD</a>
    </div>
  </section>

  <section class="landing-section soft">
    <div class="landing-shell split reverse">
      <div class="text-panel">
        <h2>Creat pentru cautari vizuale</h2>
        <p>Pagina foloseste imagini de produs, tinute si detalii pentru a prezenta clar forma, snurul si proportia pantalonilor in cautari vizuale.</p>
        <a class="primary-action" href={SHOP} target="_blank" rel="noopener">Vezi pe Atelier AXD</a>
      </div>
      <a class="image-panel" href={SHOP} target="_blank" rel="noopener">
        <img src={imageUrl(img(14))} alt={img(14).alt} title={img(14).title} width="900" height="1200" loading="lazy" decoding="async" />
      </a>
    </div>
  </section>

  <section class="guarantee">
    <div class="landing-shell">
      <h2>Comanda gestionata transparent</h2>
      <p>Comanda, livrarea, returul si plata sunt gestionate transparent pe atelieraxd.ro.</p>
      <a class="primary-action center" href={SHOP} target="_blank" rel="noopener">Vezi pe Atelier AXD</a>
    </div>
  </section>

  <section class="proof-large">
    <div class="landing-shell">
      <h2>Moda urbana fara zgomot vizual</h2>
      <div>Alb, negru estompat si albastru intens: o prezenta curata, moderna si usor de recunoscut.</div>
      <a class="primary-action center" href={SHOP} target="_blank" rel="noopener">Mergi catre magazin</a>
    </div>
  </section>

  <section class="landing-section faq-split">
    <div class="landing-shell split">
      <a class="image-panel" href={SHOP} target="_blank" rel="noopener">
        <img src={imageUrl(img(20))} alt={img(20).alt} title={img(20).title} width="900" height="1200" loading="lazy" decoding="async" />
      </a>
      <div class="faq-panel">
        <h2>Intrebari frecvente</h2>
        {faqs.slice(0, 4).map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
        <a class="primary-action" href={SHOP} target="_blank" rel="noopener">Vezi colectia</a>
      </div>
    </div>
  </section>

  <section class="landing-section offers">
    <div class="landing-shell offer-grid">
      <a class="offer-card wide" href={SHOP} target="_blank" rel="noopener">
        <img src={imageUrl(img(21))} alt={img(21).alt} title={img(21).title} width="1200" height="900" loading="lazy" decoding="async" />
        <span>Modele noi</span>
        <strong>Modele noi cu snur lung</strong>
      </a>
      <a class="offer-card" href={SHOP} target="_blank" rel="noopener">
        <img src={imageUrl(img(22))} alt={img(22).alt} title={img(22).title} width="1200" height="900" loading="lazy" decoding="async" />
        <span>Croiala</span>
        <strong>Croieli relaxate</strong>
      </a>
      <a class="offer-card" href={SHOP} target="_blank" rel="noopener">
        <img src={imageUrl(img(18))} alt={img(18).alt} title={img(18).title} width="1200" height="900" loading="lazy" decoding="async" />
        <span>Sezon</span>
        <strong>Variante scurte</strong>
      </a>
    </div>
  </section>

  <section class="final-cta">
    <div class="landing-shell">
      <p>Ghid informativ pentru stil urban</p>
      <h2>Alege croiala relaxata care tine tinuta curata si intentionata.</h2>
      <a class="white-action" href={SHOP} target="_blank" rel="noopener">Vezi pe Atelier AXD</a>
    </div>
  </section>
</Layout>
