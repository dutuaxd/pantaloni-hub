---
import Layout from '../layouts/Layout.astro';
import { SITE, ATELIER_HOME, organizationSchema, websiteSchema } from '../data/seoSite';
import { atelierRecommendations, editorialArticles, portalCategoryGroups, socialLinks } from '../data/portalContent';
import { blogPosts } from '../data/seoSite';
import { publicPage } from '../data/publicCopy';

const title = 'PSL Fashion | Revista si catalog de fashion masculin';
const description = 'PSL Fashion este un portal editorial despre pantaloni, tricouri, hanorace, tinute masculine, trenduri, ghiduri si recomandari informative AtelierAXD.';
const canonical = `${SITE}/`;
const featured = publicPage(blogPosts[0]);
const newsItems = editorialArticles.filter((page) => page.slug.startsWith('news/')).slice(0, 4);
const guideItems = editorialArticles.filter((page) => page.slug.startsWith('ghiduri/')).slice(0, 4);
const featuredInternalPosts = [
  'blog/tricou-gri-oversized-cusaturi-laterale',
  'blog/tricou-gri-prespalat-buzunar-aplicat',
  'blog/tricou-negru-oversized-minimalist',
]
  .map((slug) => blogPosts.find((post) => post.slug === slug))
  .filter(Boolean)
  .map(publicPage);
const recentPosts = [...featuredInternalPosts, ...blogPosts.slice(1, 5).map(publicPage)];
const imagePath = (image: string) => image.startsWith('images/') ? `/${image}` : image.endsWith('.webp') ? `/images/products/${image}` : `/${image}`;
const heroImage = '/moda-urbana-pantaloni-unisex-cu-snur-lung.png';
const sideStories = [
  ['/pantaloni/', 'Pantaloni', 'Croieli largi, cargo, jogger si modele cu snur.', '/images/products/pantaloni-cu-snur-lung-negri-barbati-outfit.webp'],
  ['/tricouri/', 'Tricouri', 'Oversize, basic, negru, alb si piese de vara.', '/tricou-gri-simplu-pantaloni-siret-lung-produs.png'],
  ['/hanorace/', 'Hanorace', 'Layering, streetwear si tinute casual.', '/images/atelieraxd-long-tail/pantaloni-cu-snur-lung-hanorac-negru-simplu-siret-lung-hoodie-negru-minimalist.jpg'],
  ['/tinute/', 'Tinute', 'Idei rapide pentru oras, vara si all black.', '/outfit-casual-tricou-pantaloni-negri-snur-lung.png'],
];
const trendStories = [
  ['/tinute-streetwear/', 'Streetwear purtabil', 'Volume relaxate, culori neutre si piese care raman usor de integrat.', '/tinuta-unisex-pantaloni-largi-snur-extra-lung.png'],
  ['/tinute-vara/', 'Vara', 'Pantaloni scurti, tricouri usoare si tonuri deschise.', '/set-alb-pantaloni-scurti-siret-lung-outfit.png'],
  ['/tinute-all-black/', 'All black', 'Texturi diferite si proportii clare pentru tinute monocrome.', '/pantaloni-barbati-largi-negri-snur-casual.jpg'],
];
const schema = [
  organizationSchema(),
  websiteSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    isPartOf: { '@type': 'WebSite', name: 'PSL Fashion', url: SITE },
  },
];
---
<Layout title={title} description={description} canonical={canonical} image="/og-pantaloni-cu-snur-lung.jpg" schema={schema}>
  <section class="mag-hero">
    <div class="container mag-hero-grid">
      <article class="mag-featured">
        <a href={`/${featured.slug}/`}>
          <div class="mag-featured-media">
            <img src={heroImage} alt="Tinuta urbana cu pantaloni largi si snur lung" width="1200" height="1500" loading="eager" fetchpriority="high" />
          </div>
          <div class="mag-featured-copy">
            <span>Articol featured</span>
            <h1>Tinute casual masculine pentru 2026</h1>
            <p>Un ghid vizual pentru pantaloni relaxati, tricouri oversize, hanorace curate si combinatii usor de purtat zilnic.</p>
            <strong class="mag-read-link">Citeste articolul</strong>
          </div>
        </a>
      </article>
      <aside class="mag-cover-list" aria-label="Subiecte principale">
        {sideStories.map(([href, label, text, image]) => (
          <a href={href}>
            <img src={image} alt={label} width="240" height="180" loading="eager" decoding="async" />
            <span>
              <strong>{label}</strong>
              <small>{text}</small>
            </span>
          </a>
        ))}
      </aside>
    </div>
  </section>

  <section class="mag-section">
    <div class="container">
      <div class="mag-section-head">
        <span>News grid</span>
        <h2>Articole recente</h2>
      </div>
      <div class="mag-news-grid">
        {[...newsItems, ...recentPosts].slice(0, 6).map((item) => (
          <article class="mag-card">
            <a href={`/${item.slug}/`}>
              <img src={imagePath(item.image)} alt={item.h1} width="640" height="480" loading="lazy" decoding="async" />
              <span>{item.category || 'Fashion'}</span>
              <h3>{item.h1}</h3>
              <p>{item.intro || item.description}</p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mag-section alt">
    <div class="container">
      <div class="mag-section-head">
        <span>Tendinte</span>
        <h2>Ce urmarim in garderoba masculina</h2>
      </div>
      <div class="mag-trend-row">
        {trendStories.map(([href, title, copy, image]) => (
          <a href={href}>
            <img src={image} alt={title} width="760" height="860" loading="lazy" decoding="async" />
            <strong>{title}</strong>
            <p>{copy}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {portalCategoryGroups.slice(0, 4).map(([title, slugs]) => (
    <section class="mag-section">
      <div class="container">
        <div class="mag-section-head">
          <span>{title}</span>
          <h2>{title}</h2>
        </div>
        <div class="mag-link-grid">
          {slugs.map((slug) => {
            const page = editorialArticles.find((item) => item.slug === slug);
            return page && (
              <a href={`/${page.slug}/`}>
                <strong>{page.h1}</strong>
                <span>{page.intro}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <section class="mag-section alt">
    <div class="container">
      <div class="mag-section-head">
        <span>Ghiduri</span>
        <h2>Citeste inainte sa alegi</h2>
      </div>
      <div class="mag-news-grid compact">
        {guideItems.map((item) => (
          <article class="mag-card">
            <a href={`/${item.slug}/`}>
              <img src={imagePath(item.image)} alt={item.h1} width="640" height="480" loading="lazy" decoding="async" />
              <span>Ghid</span>
              <h3>{item.h1}</h3>
              <p>{item.intro}</p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mag-section">
    <div class="container">
      <div class="mag-section-head">
        <span>Recomandari AtelierAXD</span>
        <h2>Produse si idei de styling</h2>
      </div>
      <div class="mag-product-grid">
        {atelierRecommendations.map((item) => (
          <article class="mag-product-card">
            <img src={item.image} alt={item.title} width="800" height="1000" loading="lazy" decoding="async" />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a href={item.href} target="_blank" rel="noopener">Vezi stocul actualizat pe AtelierAXD</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mag-social-proof">
    <div class="container">
      <h2>Urmareste comunitatea noastra de fashion masculin</h2>
      <div>
        {socialLinks.map(([href, label]) => <a href={href} target="_blank" rel="noopener">{label}</a>)}
        <a href={ATELIER_HOME} target="_blank" rel="noopener">AtelierAXD</a>
      </div>
    </div>
  </section>
</Layout>
