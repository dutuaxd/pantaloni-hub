---
import Layout from '../layouts/Layout.astro';
import { SITE, allContentPages, blogPosts, organizationSchema, updated, websiteSchema } from '../data/seoSite';
import { editorialArticles, portalCategoryGroups } from '../data/portalContent';
import { publicPage } from '../data/publicCopy';
import { internationalLocales } from '../data/internationalSeo';

const title = 'Pantalonicusnurlung.ro | Enciclopedia Fashion Romania';
const description = 'Cea mai mare enciclopedie fashion din Romania: articole despre moda, pantaloni, textile, materiale, branduri, culori, stiluri, ingrijire si ghiduri vestimentare.';
const canonical = `${SITE}/`;
const image = '/og-pantaloni-cu-snur-lung.jpg';
const pages = allContentPages.map(publicPage);
const recentPosts = blogPosts.slice(0, 8).map(publicPage);
const updatedPosts = [...blogPosts].slice(8, 16).map(publicPage);
const newPosts = [...blogPosts].slice(16, 24).map(publicPage);
const trendingPosts = [...blogPosts].slice(24, 32).map(publicPage);
const featured = publicPage(blogPosts[0]);
const imagePath = (src = '') => src.startsWith('images/') ? `/${src}` : src.endsWith('.webp') ? `/images/products/${src}` : `/${src}`;
const lookup = (slug: string) => editorialArticles.find((page) => page.slug === slug) || pages.find((page) => page.slug === slug);
const todayCards = [
  { label: 'Brandul zilei', title: 'Atelier AXD', text: 'Brand romanesc analizat prin croieli relaxate, styling urban si rolul sau in ecosistemul editorial.', href: '/despre-atelier-axd/' },
  { label: 'Materialul zilei', title: 'Bumbac', text: 'Fibra naturala de baza pentru pantaloni, tricouri si piese casual usor de intretinut.', href: '/ghiduri/materiale/' },
  { label: 'Textila zilei', title: 'Jersey', text: 'Tricot flexibil folosit in tricouri, haine lejere si articole cu mobilitate mare.', href: '/ingrijire-textile/' },
  { label: 'Stilul zilei', title: 'Streetwear minimalist', text: 'Volum controlat, culori neutre si piese curate pentru tinute urbane coerente.', href: '/tinute-streetwear/' },
  { label: 'Culoarea zilei', title: 'Negru', text: 'Baza pentru outfituri all black, contrast textural si combinatii usor de citit.', href: '/ghiduri/culori/' },
  { label: 'Ghidul zilei', title: 'Cum alegi croiala', text: 'Slim, drept, loose, baggy si oversized explicate ca termeni de orientare.', href: '/ghiduri/croieli/' },
];
const popularCategories = [
  ['Pantaloni', '/pantaloni/', 'Croieli, lungimi, talie, snur, fit si contexte de purtare.'],
  ['Materiale', '/ghiduri/materiale/', 'Bumbac, denim, fleece, lana, poliester, vascoza si fibre tehnice.'],
  ['Textile', '/ingrijire-textile/', 'Tesaturi, tricoturi, intretinere si comportament la spalare.'],
  ['Culori', '/ghiduri/culori/', 'Palete, asortari, contraste si combinatii vestimentare.'],
  ['Stiluri', '/tinute/', 'Streetwear, casual, all black, vara, birou si evenimente.'],
  ['Glosar fashion', '/fashion/', 'Termeni explicati pentru fit, materiale, croieli si styling.'],
];
const popularBrands = [
  ['Atelier AXD', '/despre-atelier-axd/'],
  ['Nike', '/fashion/'],
  ['Adidas', '/fashion/'],
  ['Zara', '/fashion/'],
  ['Uniqlo', '/fashion/'],
  ['H&M', '/fashion/'],
];
const popularMaterials = [
  ['Bumbac', '/ghiduri/materiale/'],
  ['Denim', '/ingrijire-textile/'],
  ['Poliester', '/blog/ingrijire-textile/solutie-enzimatica-poliester-haine-purtate-des/'],
  ['Vascoza', '/blog/ingrijire-textile/otet-alb-clatire-vascoza-pantaloni-tricouri/'],
  ['Casmir', '/blog/ingrijire-textile/spray-pretratare-casmir-haine-albe/'],
  ['Softshell', '/blog/ingrijire-textile/balsam-rufe-softshell-haine-colorate/'],
];
const glossaryTerms = [
  ['Baggy', '/pantaloni-baggy-negri/'],
  ['Oversized', '/pantaloni-oversized/'],
  ['Loose fit', '/pantaloni-loose-fit/'],
  ['Cargo', '/pantaloni-cargo/'],
  ['Jersey', '/ghiduri/materiale/'],
  ['All black', '/tinute-all-black/'],
  ['Snur lung', '/ce-sunt-pantalonii-cu-snur-lung/'],
  ['Siret lung', '/pantaloni-cu-siret-lung/'],
  ['Stacking', '/blog/cum-alegi-pant-stacking/'],
  ['Streetwear', '/streetwear-romania/'],
  ['Capsule wardrobe', '/blog/pantaloni-largi-barbati-capsule-wardrobe/'],
  ['Old money', '/blog/haine-old-money-barbati-cu-pantaloni-lejeri/'],
];
const quickLinks = [
  ['Branduri', '#branduri'],
  ['Pantaloni', '/pantaloni/'],
  ['Materiale', '/ghiduri/materiale/'],
  ['Textile', '/ingrijire-textile/'],
  ['Culori', '/ghiduri/culori/'],
  ['Stiluri', '/tinute/'],
  ['Intretinere', '/ingrijire-textile/'],
  ['Ghiduri', '/ghiduri/'],
  ['Glosar', '#glosar'],
];
const schema = [
  organizationSchema(),
  websiteSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonical,
    isPartOf: { '@type': 'WebSite', name: 'Pantalonicusnurlung.ro', url: SITE },
  },
];
---
<Layout title={title} description={description} canonical={canonical} image={image} schema={schema}>
  <section class="ency-hero">
    <div class="container">
      <div class="ency-hero-inner">
        <p class="ency-kicker">Enciclopedie fashion in limba romana</p>
        <h1>Cea mai mare enciclopedie fashion din Romania.</h1>
        <p>Exploreaza peste 10.000 de articole despre moda, textile, branduri, materiale, culori, stiluri vestimentare si intretinerea hainelor.</p>
        <form class="ency-search" action="/blog/" method="get" role="search">
          <label for="home-search">Cauta in enciclopedia fashion</label>
          <input id="home-search" name="q" type="search" placeholder="Cauta branduri, materiale, pantaloni, culori, stiluri..." />
          <button type="submit">Cauta</button>
        </form>
        <nav class="ency-quick-links" aria-label="Linkuri rapide">
          {quickLinks.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
      </div>
    </div>
  </section>

  <section class="ency-band">
    <div class="container home-main-grid">
      <article class="ency-feature">
        <a href={`/${featured.slug}/`}>
          <img src={imagePath(featured.image)} alt={featured.h1} width="960" height="640" loading="eager" decoding="async" />
          <span>Articol recomandat</span>
          <h2>{featured.h1}</h2>
          <p>{featured.intro || featured.description}</p>
        </a>
      </article>
      <div class="daily-grid">
        {todayCards.map((item) => (
          <a class="daily-card" href={item.href}>
            <span>{item.label}</span>
            <strong>{item.title}</strong>
            <small>{item.text}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ency-section" id="international-fashion-hubs">
    <div class="container">
      <div class="ency-section-head">
        <span>International hubs</span>
        <h2>English pages for European language audiences</h2>
      </div>
      <div class="international-hub-grid">
        {internationalLocales.map((locale) => (
          <a href={`/${locale.code}/`}>
            <strong>{locale.language}</strong>
            <span>{locale.region}</span>
            <small>Open /{locale.code}/</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ency-section">
    <div class="container">
      <div class="ency-section-head">
        <span>Actualitate editoriala</span>
        <h2>Articole recente si actualizate</h2>
      </div>
      <div class="ency-two-cols">
        <div class="ency-list-panel">
          <h3>Articole recente</h3>
          {recentPosts.map((item) => (
            <a href={`/${item.slug}/`}>
              <strong>{item.h1}</strong>
              <span>{item.category || 'Fashion'} · publicat recent</span>
            </a>
          ))}
        </div>
        <div class="ency-list-panel">
          <h3>Articole actualizate</h3>
          {updatedPosts.map((item) => (
            <a href={`/${item.slug}/`}>
              <strong>{item.h1}</strong>
              <span>Actualizat {updated}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="ency-section muted">
    <div class="container">
      <div class="ency-section-head">
        <span>Taxonomie</span>
        <h2>Categorii populare</h2>
      </div>
      <div class="taxonomy-grid">
        {popularCategories.map(([title, href, text]) => (
          <a href={href}>
            <strong>{title}</strong>
            <span>{text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ency-section" id="branduri">
    <div class="container home-directory-grid">
      <div>
        <div class="ency-section-head compact">
          <span>Entitati</span>
          <h2>Branduri populare</h2>
        </div>
        <div class="pill-directory">
          {popularBrands.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </div>
      <div>
        <div class="ency-section-head compact">
          <span>Materiale</span>
          <h2>Materiale populare</h2>
        </div>
        <div class="pill-directory">
          {popularMaterials.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </div>
      <div id="glosar">
        <div class="ency-section-head compact">
          <span>Glosar fashion</span>
          <h2>Termeni fashion populari</h2>
        </div>
        <div class="pill-directory dense">
          {glossaryTerms.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </div>
    </div>
  </section>

  <section class="ency-section muted">
    <div class="container">
      <div class="ency-section-head">
        <span>Descoperire</span>
        <h2>Pagini nou create si pagini in tendinte</h2>
      </div>
      <div class="ency-two-cols">
        <div class="ency-list-panel">
          <h3>Pagini nou create</h3>
          {newPosts.map((item) => (
            <a href={`/${item.slug}/`}>
              <strong>{item.h1}</strong>
              <span>{item.description}</span>
            </a>
          ))}
        </div>
        <div class="ency-list-panel">
          <h3>Pagini in tendinte</h3>
          {trendingPosts.map((item) => (
            <a href={`/${item.slug}/`}>
              <strong>{item.h1}</strong>
              <span>Subiect conectat la cautari, stiluri si intentii de informare.</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="ency-section">
    <div class="container">
      <div class="ency-section-head">
        <span>Hartile principale</span>
        <h2>Exploreaza enciclopedia pe clustere</h2>
      </div>
      <div class="cluster-grid">
        {portalCategoryGroups.map(([title, slugs]) => (
          <section>
            <h3>{title}</h3>
            {slugs.map((slug) => {
              const page = lookup(slug);
              return page && <a href={`/${page.slug}/`}>{page.h1}</a>;
            })}
          </section>
        ))}
      </div>
    </div>
  </section>
</Layout>
