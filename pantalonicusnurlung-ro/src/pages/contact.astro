---
import Layout from '../layouts/Layout.astro';
const title = 'Contact pantaloni cu snur lung | AtelierAXD';
const description = 'Contact pentru informatii despre pantaloni cu snur lung, comenzi, retur si colectia AtelierAXD. Scrie-ne acum!';
const canonical = 'https://pantalonicusnurlung.ro/contact/';
const image = '/pantaloni-barbati-largi-negri-snur-casual.jpg';
const schema = { '@context':'https://schema.org', '@type':'WebPage', name:title, url:canonical, image:new URL(image, canonical).href };
---
<Layout title={title} description={description} canonical={canonical} image={image} type="website" schema={schema}>
<section id="hero"><div class="hero-bg"></div><div class="container"><div class="hero-inner-wrapper"><div class="hero-content"><div class="hero-badge">Streetwear Premium Import</div><h1 class="hero-h1">Contact<br/><span class="line2">pantaloni cu snur lung</span></h1><p class="hero-sub">Pentru comenzi, stoc si livrare, foloseste canalele AtelierAXD. Hub-ul te directioneaza catre magazinul oficial.</p><div class="hero-actions"><a href="https://atelieraxd.ro/pantaloni-lungi" class="btn-primary">Vezi colectia</a><a href="/ghid-marimi-pantaloni-cu-snur" class="btn-ghost">Ghid marimi</a></div></div></div><div class="hero-stats"><div class="hero-stat"><div class="stat-num">100<span>%</span></div><div class="stat-label">Calitate superioara</div></div><div class="hero-stat"><div class="stat-num">Unisex</div><div class="stat-label">Purtat si de femei</div></div><div class="hero-stat"><div class="stat-num">1-3<span>zile</span></div><div class="stat-label">Timp livrare</div></div><div class="hero-stat"><div class="stat-num">Card</div><div class="stat-label">sau ramburs</div></div></div></div></section><section class="section"><div class="container"><div class="split-grid"><article class="content-panel reveal"><h2>Email</h2><p>atelieraxd@outlook.com</p></article><article class="content-panel reveal"><h2>WhatsApp</h2><p>Foloseste butonul verde din colt pentru un mesaj rapid.</p></article><article class="content-panel reveal"><h2>Comenzi</h2><p>Pentru comenzi active, verifica informatiile primite de la AtelierAXD.</p></article><article class="content-panel reveal"><h2>Magazin</h2><p>Pagina principala de achizitie ramane atelieraxd.ro/pantaloni-lungi.</p></article></div></div></section><section class="section"><div class="container"><div class="content-panel reveal" style="text-align:center"><span class="section-tag">// cumpara acum</span><h2 class="section-h2" style="margin:0 auto 18px">Pantaloni cu snur lung AtelierAXD</h2><p style="max-width:640px;margin:0 auto 26px">Daca ai ales stilul, mergi direct in magazin pentru modele disponibile, plata si livrare.</p><a href="https://atelieraxd.ro/pantaloni-lungi" class="btn-primary">pantaloni cu snur lung atelieraxd</a></div></div></section></Layout>
